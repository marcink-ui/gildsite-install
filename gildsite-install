#!/usr/bin/env bash
# Gildsite installer. Run by an AI on the server, which talks to the person (see INSTALL-FOR-AI.md).
# Read-only commands: check, plan, status, dns. Everything that changes the server needs `consent yes` first.
set -euo pipefail
umask 077

VERSION="0.5.0"
INSTALLER_DIR="$(cd "$(dirname "$0")" && pwd)"
GILDSITE_HOME="${GILDSITE_HOME:-/srv/gildsite}"
STATE_DIR="${GILDSITE_STATE_DIR:-$GILDSITE_HOME/.install}"
ANSWERS="$STATE_DIR/answers.env"
CONSENT="$STATE_DIR/consent"
DONE_DIR="$STATE_DIR/done"

# Until ready-made Docker images exist, the panel is built on the server; that build needs about 8 GB of memory.
MIN_RAM_GB="${MIN_RAM_GB:-8}"
MIN_DISK_GB="${MIN_DISK_GB:-30}"

STEPS=(
  "check|Look at the server (memory, disk, ports, Docker)"
  "answers|Save the website address, owner e-mail and company name"
  "consent|Get the person's yes for the plan"
  "dns|Point the address to this server"
  "run|Install and start Gildsite in Docker, HTTPS, nightly backups"
  "aurelius|Connect Aurelius to the AI on this server (optional)"
  "github|Connect GitHub for issues and pull requests (optional)"
  "finish|Check everything answers, give the owner a login link"
)

# ---------- helpers ----------
say()   { printf '%s\n' "$*"; }
ok()    { printf '  OK    %s\n' "$*"; activity ok "$*"; }
warn()  { printf '  WARN  %s\n' "$*"; activity warn "$*"; }
bad()   { printf '  FAIL  %s\n' "$*"; }
die()   { printf 'ERROR: %s\nFIX: %s\n' "$1" "${2:-Run ./gildsite-install status and tell the person what is missing.}" >&2
          [ -n "${ACTIVITY_ON:-}" ] && { activity error "$1"; progress_set failed "${RUN_STEP:-0}" "$1"; }; exit "${3:-1}"; }
have()  { command -v "$1" >/dev/null 2>&1; }

load_answers() { [ -f "$ANSWERS" ] && . "$ANSWERS"; DOMAIN="${DOMAIN:-}"; OWNER_EMAIL="${OWNER_EMAIL:-}"; COMPANY="${COMPANY:-}"; DESIGN="${DESIGN:-off}"; RELEASE="${RELEASE:-latest}"; INSTANCE="${INSTANCE:-}"; GITHUB_REPO="${GITHUB_REPO:-}"; WEB_SERVER="${WEB_SERVER:-caddy}"; [ "${GILDSITE_WWW:-}" = none ] && WEB_SERVER=existing; true; }
need_consent() { [ -f "$CONSENT" ] || die "The person has not agreed to the plan yet." "Run ./gildsite-install plan, explain it, and after a clear yes run ./gildsite-install consent yes." 2; }
mark_done() { mkdir -p "$DONE_DIR"; date -u +%FT%TZ > "$DONE_DIR/$1"; }
is_done() { [ -f "$DONE_DIR/$1" ]; }

ram_gb()  { awk '/MemTotal/ {printf "%d", $2/1024/1024 + 0.5}' /proc/meminfo 2>/dev/null || echo 0; }
disk_gb() { local p="$GILDSITE_HOME"; while [ ! -d "$p" ]; do p=$(dirname "$p"); done; df -BG --output=avail "$p" | tail -1 | tr -dc 0-9; }
port_busy() { have ss && ss -ltnH "( sport = :$1 )" 2>/dev/null | grep -q .; }
public_ip() { curl -fsS --max-time 5 https://api.ipify.org 2>/dev/null || { hostname -I 2>/dev/null || true; } | awk '{print $1}'; }
resolve() { { getent ahostsv4 "$1" 2>/dev/null || true; } | awk 'NR==1 {print $1}'; }

# ---------- commands ----------
cmd_check() {
  local fails=0 json="${1:-}"
  local os="unknown" arch ram disk
  [ -f /etc/os-release ] && os=$(. /etc/os-release; echo "$ID $VERSION_ID")
  arch=$(uname -m); ram=$(ram_gb); disk=$(disk_gb)
  local ais=() a; for a in claude codex gemini opencode; do have "$a" && ais+=("$a"); done

  if [ "$json" = "--json" ]; then
    printf '{"os":"%s","arch":"%s","ram_gb":%s,"disk_free_gb":%s,"docker":%s,"port80_busy":%s,"port443_busy":%s,"root":%s,"ai_clients":"%s","gh":%s}\n' \
      "$os" "$arch" "$ram" "$disk" "$(have docker && echo true || echo false)" \
      "$(port_busy 80 && echo true || echo false)" "$(port_busy 443 && echo true || echo false)" \
      "$([ "$(id -u)" = 0 ] && echo true || echo false)" "${ais[*]:-}" "$(have gh && echo true || echo false)"
    return 0
  fi

  say "Gildsite installer $VERSION: server check (nothing is changed)"
  case "$os" in ubuntu*|debian*) ok "System: $os" ;; *) warn "System: $os (tested on Ubuntu and Debian)";; esac
  case "$arch" in x86_64|aarch64) ok "Processor: $arch" ;; *) bad "Processor: $arch is not supported"; fails=$((fails+1));; esac
  if [ "$ram" -ge "$MIN_RAM_GB" ]; then ok "Memory: ${ram} GB"; else bad "Memory: ${ram} GB, needs at least ${MIN_RAM_GB} GB"; fails=$((fails+1)); fi
  if [ "$disk" -ge "$MIN_DISK_GB" ]; then ok "Free disk: ${disk} GB"; else bad "Free disk: ${disk} GB, needs at least ${MIN_DISK_GB} GB"; fails=$((fails+1)); fi
  if [ "$(id -u)" = 0 ] || (have sudo && sudo -n true 2>/dev/null); then ok "Admin rights: yes"; else bad "Admin rights: no (run as root or with sudo)"; fails=$((fails+1)); fi
  if have docker; then ok "Docker: $(docker --version 2>/dev/null | cut -d, -f1)"; else warn "Docker: not installed yet (the installer will add it)"; fi
  local p; for p in 80 443; do
    if port_busy "$p"; then warn "Port $p is used by another program. The installer will not take it over; answer WEB_SERVER existing to keep the current web server."; else ok "Port $p: free"; fi
  done
  if [ ${#ais[@]} -gt 0 ]; then ok "AI on this server: ${ais[*]} (Aurelius can connect to it)"; else warn "AI on this server: none found (Aurelius can still use an API key in the panel)"; fi
  if have gh; then ok "GitHub tool: installed"; else warn "GitHub tool: not installed (optional, the installer can add it)"; fi
  say ""
  if [ "$fails" -eq 0 ]; then say "READY: the server can run Gildsite."; else say "NOT READY: $fails problem(s) above."; return 1; fi
}

cmd_answer() {
  local key="${1:-}" val="${2:-}"
  case "$key" in
    DOMAIN) echo "$val" | grep -Eq '^([a-z0-9-]+\.)+[a-z]{2,}$' || die "\"$val\" does not look like a website address." "Ask for an address like www.company.com (no https://, no slash)." ;;
    OWNER_EMAIL) echo "$val" | grep -Eq '^[^@ ]+@[^@ ]+\.[^@ ]+$' || die "\"$val\" does not look like an e-mail." "Ask for the owner's e-mail again." ;;
    COMPANY) [ -n "$val" ] || die "Company name is empty." "Ask for the company name." ;;
    DESIGN) case "$val" in on|off) ;; *) die "DESIGN must be on or off." "Use: answer DESIGN on";; esac ;;
    RELEASE) [ -n "$val" ] || die "RELEASE is empty." "Use a release tag like v1.2.0, or latest." ;;
    INSTANCE) echo "$val" | grep -Eq '^[a-z][a-z0-9-]{1,29}$' || die "INSTANCE must be 2-30 small letters, digits or dashes." "Use something like firma." ;;
    WEB_SERVER) case "$val" in caddy|existing) ;; *) die "WEB_SERVER must be caddy or existing." "Use existing when nginx or Apache already serves ports 80 and 443 on this server.";; esac ;;
    GITHUB_REPO) echo "$val" | grep -Eq '^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$' || die "\"$val\" is not a repository name." "Use owner/name, for example your-company/website." ;;
    *) die "Unknown answer \"$key\"." "Use one of: DOMAIN, OWNER_EMAIL, COMPANY, DESIGN, RELEASE, INSTANCE, WEB_SERVER, GITHUB_REPO." ;;
  esac
  mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"; touch "$ANSWERS"; chmod 600 "$ANSWERS"
  grep -v "^$key=" "$ANSWERS" > "$ANSWERS.tmp" || true
  printf '%s=%q\n' "$key" "$val" >> "$ANSWERS.tmp"; chmod 600 "$ANSWERS.tmp"; mv "$ANSWERS.tmp" "$ANSWERS"
  # A new answer after consent changes the plan, so the person has to agree again.
  [ "$key" != GITHUB_REPO ] && [ -f "$CONSENT" ] && rm -f "$CONSENT" && say "The plan changed, so the earlier yes no longer counts. Show the plan again."
  say "Saved $key."
}

cmd_plan() {
  load_answers
  local missing=()
  [ -n "$DOMAIN" ] || missing+=(DOMAIN); [ -n "$OWNER_EMAIL" ] || missing+=(OWNER_EMAIL); [ -n "$COMPANY" ] || missing+=(COMPANY)
  [ ${#missing[@]} -eq 0 ] || die "Missing answers: ${missing[*]}." "Ask the person and save each with ./gildsite-install answer KEY VALUE."
  cat <<PLAN
PLAN (nothing has been changed yet)

Website:  https://$DOMAIN
Panel:    https://$DOMAIN/admin
Owner:    $OWNER_EMAIL
Company:  $COMPANY

What will happen on this server:
  1. Install Docker (if missing) and create the folder $GILDSITE_HOME.
  2. $( [ -n "${GILDSITE_SOURCE:-}" ] && echo "Take the Gildsite code from the local copy ${GILDSITE_SOURCE}." || echo "Download Gildsite release \"$RELEASE\" from GitHub." )
  3. Start in Docker: website, panel, database, search, Aurelius engine$( [ "$DESIGN" = on ] && echo ", Design" ).
$( if [ "$WEB_SERVER" = existing ]; then echo "  4. Keep the web server already running here (nginx or Apache): the installer writes a ready config file
     for it and does not change it. Whoever looks after that server adds the file and the HTTPS certificate."; echo "  5. The panel and website listen only inside the server; the existing web server passes visitors to them."; else echo "  4. Start the web server (Caddy) with an HTTPS certificate for the address."; echo "  5. Open only ports 80 and 443 for the website. The database and panel internals stay inside the server."; echo "     (An existing firewall is not changed.)"; fi )
  6. Turn on a nightly backup of the database and photos (kept 7 days).
  7. Create the owner account for $OWNER_EMAIL and give a one-time link to set the password.

What will NOT happen:
  - No other programs or websites on this server are changed or stopped.
  - No passwords or keys are shown in the chat; they are stored in files only root can read.

Optional after install (asked separately): connect Aurelius to the AI on this server, connect GitHub.
PLAN
}

cmd_consent() {
  [ "${1:-}" = yes ] || die "Consent must be given as: consent yes" "Only run this after the person clearly said yes to the plan."
  cmd_plan >/dev/null
  mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"
  { date -u +%FT%TZ; sha256sum "$ANSWERS" | cut -d' ' -f1; } > "$CONSENT"
  say "Consent recorded. Next: ./gildsite-install dns"
}

cmd_dns() {
  load_answers
  [ -n "$DOMAIN" ] || die "No website address yet." "Run ./gildsite-install answer DOMAIN <address> first."
  local ip; ip=$(public_ip)
  [ -n "$ip" ] || die "Could not find this server's public address." "Ask the person for the server's IP address (it is in their hosting panel)."
  local bare=""; case "$DOMAIN" in www.*) bare="${DOMAIN#www.}";; esac
  say "Add at the domain provider (DNS settings):"
  say "  Type A   Name: $DOMAIN   Value: $ip"
  [ -n "$bare" ] && say "  Type A   Name: $bare   Value: $ip   (optional: the address without www then opens the site too)"
  say ""
  local got; got=$(resolve "$DOMAIN")
  if [ "$got" = "$ip" ]; then ok "$DOMAIN points to this server"; else warn "$DOMAIN ${got:+points to $got}${got:-is not set yet}"; fi
  if [ -n "$bare" ]; then local g2; g2=$(resolve "$bare"); [ "$g2" = "$ip" ] && ok "$bare points to this server" || warn "$bare not pointing here (optional)"; fi
  if [ "$got" = "$ip" ]; then mark_done dns; say "DNS READY. Next: ./gildsite-install run"; else say "Waiting for DNS. New records usually work within 5–30 minutes. Run this again in a minute or two."; return 4; fi
}

# ---------- install (step "run") ----------
# The site itself comes from the private repo webdev-wzornik. Its own script skrypty/nowy-klient.sh creates the instance
# in /srv/klienci/<name>; this installer prepares the source, then switches the instance from test mode to production
# and puts the Caddy web server in front. Every part is skipped when already done, so `run` can be repeated safely.
SOURCE_REPO="${GILDSITE_SOURCE_REPO:-marcink-ui/webdev-wzornik}"
SOURCE_DIR="$GILDSITE_HOME/zrodlo"
WWW_DIR="$GILDSITE_HOME/www"
KEY_FILE="$STATE_DIR/download-key"
LOG="$STATE_DIR/install.log"

instance_name() { local n="${INSTANCE:-}"; [ -n "$n" ] || n=$(echo "${DOMAIN#www.}" | cut -d. -f1 | tr -c 'a-z0-9-\n' '-' | sed 's/^[^a-z]*//' | cut -c1-30); [ ${#n} -ge 2 ] || n="gildsite"; echo "$n"; }
inst_dir() { echo "${GILDSITE_CLIENTS_DIR:-/srv/klienci}/$(instance_name)"; }
sudo_() { if [ "$(id -u)" = 0 ]; then "$@"; else sudo "$@"; fi; }
step() { printf '\n== %s\n' "$*"; printf '\n== %s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$LOG"
  case "$*" in [1-7]/7*) RUN_STEP=${1%%/*}; progress_set running "$RUN_STEP" "$*";; esac; activity step "Working on: ${*#[1-7]/7 }"; }
logrun() { "$@" >> "$LOG" 2>&1; }
# Proxy settings of the server (if any) are passed to build and install containers.
proxy_args() { local v; for v in HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy; do [ -n "${!v:-}" ] && printf -- '--build-arg %s=%s ' "$v" "${!v}"; done; true; }
proxy_env()  { local v; for v in HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy; do [ -n "${!v:-}" ] && printf -- '-e %s=%s ' "$v" "${!v}"; done; [ -n "${GILDSITE_EXTRA_CA:-}" ] && printf -- '-v %s:/extra-ca.crt:ro -e NODE_EXTRA_CA_CERTS=/extra-ca.crt ' "$GILDSITE_EXTRA_CA"; true; }
setenv() { # setenv FILE KEY VALUE: replace or add one line in a .env file
  local f="$1" k="$2" v="$3"; grep -v "^$k=" "$f" > "$f.tmp" || true; printf '%s=%s\n' "$k" "$v" >> "$f.tmp"; cat "$f.tmp" > "$f"; rm -f "$f.tmp"; }
dropenv() { local f="$1"; shift; local k; for k in "$@"; do grep -v "^$k=" "$f" > "$f.tmp" || true; cat "$f.tmp" > "$f"; rm -f "$f.tmp"; done; }

run_docker() {
  step "1/7 Docker"
  if have docker && docker info >/dev/null 2>&1; then ok "Docker is running"; return; fi
  have docker || { say "Installing Docker (official script from get.docker.com)…"; curl -fsSL https://get.docker.com | sudo_ sh >> "$LOG" 2>&1 || die "Docker could not be installed." "Show the person the last lines of $LOG."; }
  sudo_ systemctl enable --now docker >> "$LOG" 2>&1 || true
  docker info >/dev/null 2>&1 || die "Docker is installed but not running." "Restart the server once, then run ./gildsite-install run again."
  ok "Docker installed"
}

run_source() {
  step "2/7 Gildsite code ($RELEASE)"
  if [ -n "${GILDSITE_SOURCE:-}" ]; then # local copy (tests, or a server without GitHub access)
    if [ ! -d "$SOURCE_DIR/.git" ]; then
      mkdir -p "$GILDSITE_HOME"; local src="$GILDSITE_SOURCE"
      # A folder owned by another user makes git refuse ("dubious ownership"), so a folder goes through a bundle file.
      if [ -d "$src" ]; then src="$STATE_DIR/source.bundle"; logrun git -c safe.directory='*' -C "$GILDSITE_SOURCE" bundle create "$src" HEAD || die "Reading the local copy $GILDSITE_SOURCE failed." "Check $LOG."; fi
      logrun git clone -q "$src" "$SOURCE_DIR" || die "Copying the code from $GILDSITE_SOURCE failed." "Check $LOG."
      rm -f "$STATE_DIR/source.bundle"
    fi
    ok "Code from local copy $GILDSITE_SOURCE"; return
  fi
  local url="https://github.com/$SOURCE_REPO.git" ref="$RELEASE"
  if [ ! -d "$SOURCE_DIR/.git" ]; then
    mkdir -p "$GILDSITE_HOME"
    if have gh && gh auth status >/dev/null 2>&1 && gh repo view "$SOURCE_REPO" >/dev/null 2>&1; then
      logrun gh repo clone "$SOURCE_REPO" "$SOURCE_DIR" || die "Download from GitHub failed." "Check $LOG; then run again."
    elif [ -s "$KEY_FILE" ]; then
      logrun git -c "http.extraHeader=Authorization: Basic $(printf 'x-access-token:%s' "$(cat "$KEY_FILE")" | base64 -w0)" clone "$url" "$SOURCE_DIR" \
        || die "Download from GitHub failed: the download key is wrong or expired." "Ask the person for a new download key and save it with ./gildsite-install key."
    else
      die "No access to the Gildsite code yet." "Ask the person for the download key they got with Gildsite, then save it with ./gildsite-install key (it reads the key from input, never print it)." 5
    fi
  fi
  if [ "$ref" != latest ]; then logrun git -C "$SOURCE_DIR" fetch --tags -q || true; logrun git -C "$SOURCE_DIR" checkout -q "$ref" || die "Release $ref not found." "Use ./gildsite-install answer RELEASE latest, or a release that exists."; fi
  ok "Code ready ($(git -C "$SOURCE_DIR" log -1 --format=%h))"
}

run_deps() {
  step "3/7 Libraries (a few minutes)"
  # shellcheck disable=SC2046
  if docker image inspect klient-node:22 >/dev/null 2>&1; then ok "Base image already there"; else
    logrun docker build --network host $(proxy_args) -t klient-node:22 "$SOURCE_DIR/obraz" || die "Building the base image failed." "Check internet access from the server and $LOG."
    ok "Base image built"; fi
  local d
  for d in app astro wektory; do
    [ -f "$SOURCE_DIR/$d/package-lock.json" ] || continue
    if [ -d "$SOURCE_DIR/$d/node_modules" ] && [ -f "$SOURCE_DIR/$d/node_modules/.package-lock.json" ]; then ok "$d: already installed"; continue; fi
    # shellcheck disable=SC2046
    logrun docker run --rm --network host $(proxy_env) -v "$SOURCE_DIR/$d:/w" -w /w klient-node:22 npm ci --no-audit --no-fund --loglevel=error \
      || die "Installing libraries for $d failed." "Check internet access from the server and $LOG."
    ok "$d: installed"
  done
}

run_instance() {
  local name dir; name=$(instance_name); dir=$(inst_dir)
  step "4/7 Website and panel ($name), first build (10–20 minutes)"
  if [ -f "$dir/.env" ] && docker ps --format '{{.Names}}' | grep -q "^$name-panel$"; then models_owner "$dir"; ok "Instance $name already exists"; return; fi
  [ -e "$dir" ] && die "Folder $dir exists but the instance is not running." "Do not delete it. Tell Marcin; the folder may hold someone's data."
  sudo_ mkdir -p "$(dirname "$dir")"
  if ! MIN_GB="${MIN_GB:-15}" logrun sh "$SOURCE_DIR/skrypty/nowy-klient.sh" "$name"; then
    # The last parts of nowy-klient (Knowledge wiki, its timer) are extras: if panel and website run, we go on.
    if [ -f "$dir/.env" ] && docker ps --format '{{.Names}}' | grep -q "^$name-panel$" && docker ps --format '{{.Names}}' | grep -q "^$name-strona$"; then
      models_owner "$dir"; warn "Instance $name runs, but an extra (Knowledge wiki or its timer) did not finish. It retries later; see $LOG."
      return
    fi
    die "Creating the instance failed." "Show the person the last lines of $LOG (no passwords are in it)."
  fi
  models_owner "$dir"
  ok "Instance $name created"
}
# Search needs dane/modele owned by the instance user; when Docker creates it, it belongs to root and search keeps restarting.
models_owner() { local d="$1" u; u=$(grep '^UID_KLIENTA=' "$d/.env" | cut -d= -f2); [ -n "$u" ] || return 0
  sudo_ mkdir -p "$d/dane/modele"; [ "$(stat -c %u "$d/dane/modele")" = "$u" ] && return 0
  sudo_ chown -R "$u:$u" "$d/dane/modele"; ( cd "$d" && docker compose restart wektory >> "$LOG" 2>&1 ) || true; ok "Search model folder fixed (owner $u)"; }

run_production() {
  local name dir e sub; name=$(instance_name); dir=$(inst_dir); e="$dir/.env"
  step "5/7 Production settings and owner account"
  if is_done production; then ok "Already in production mode"; return; fi
  cp -p "$e" "$e.przed-instalator-$(date -u +%Y%m%d%H%M%S)"
  sub=$(grep '^PODSIEC=' "$e" | cut -d= -f2 | sed 's#\.0/24##')
  # Test mode off: no fake Google, no sandbox profile (Google sign-in is set up later in Connectors).
  dropenv "$e" TRYB COMPOSE_PROFILES PORT_GOOGLE GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET GOOGLE_AUTH_URL GOOGLE_TOKEN_URL GOOGLE_USERINFO_URL GOOGLE_DOMENY
  setenv "$e" DOMENA "${DOMAIN#www.}"
  setenv "$e" FIRMA "\"$COMPANY\""
  setenv "$e" ADRES_PUBLICZNY "https://$DOMAIN"
  # Only the web server in front is trusted for the visitor's IP: Caddy from a fixed address in the instance network,
  # an existing nginx/Apache through the Docker gateway (.1) of that network.
  if [ "$WEB_SERVER" = existing ]; then setenv "$e" ZAUFANE_PROXY "$sub.1"; else setenv "$e" ZAUFANE_PROXY "$sub.250"; fi
  docker rm -f "$name-google-atrapa" >/dev/null 2>&1 || true
  # Owner account: the e-mail the person gave; other demo accounts stay locked with random passwords.
  install -m 644 "$INSTALLER_DIR/templates/wlasciciel.ts" "$dir/app/tools/gildsite-install-wlasciciel.ts"
  ( cd "$dir" && OWNER_EMAIL="$OWNER_EMAIL" COMPANY="$COMPANY" logrun docker compose --profile narzedzia run --rm -T -e OWNER_EMAIL -e COMPANY narzedzia npx payload run tools/gildsite-install-wlasciciel.ts ) \
    || die "Setting the owner e-mail failed." "Check $LOG."
  ( cd "$dir" && MIN_GB="${MIN_GB:-15}" logrun sh skrypty/buduj.sh oba ) || die "Build with production settings failed." "Check $LOG; the earlier version keeps running."
  ( cd "$dir" && logrun sh skrypty/start.sh ) || true
  mark_done production; ok "Production mode on, owner: $OWNER_EMAIL"
}

run_www() {
  local name dir sub; name=$(instance_name); dir=$(inst_dir)
  sub=$(grep '^PODSIEC=' "$dir/.env" | cut -d= -f2 | sed 's#\.0/24##')
  local alias=""; case "$DOMAIN" in www.*) alias="${DOMAIN#www.}";; esac
  if [ "$WEB_SERVER" = existing ]; then
    step "6/7 Config for the existing web server (not changed by the installer)"
    local pp ps f="$GILDSITE_HOME/nginx-$name.conf"
    pp=$(grep '^PORT_PANEL=' "$dir/.env" | cut -d= -f2); ps=$(grep '^PORT_STRONA=' "$dir/.env" | cut -d= -f2)
    sed -e "s#__DOMAIN__#$DOMAIN#g" -e "s#__ALIAS__#${alias}#g" -e "s#__PORT_PANEL__#$pp#g" -e "s#__PORT_STRONA__#$ps#g" \
      "$INSTALLER_DIR/templates/nginx-site.conf.template" > "$f"; chmod 644 "$f"
    ok "nginx config written: $f"
    warn "Whoever looks after this server copies it to /etc/nginx/sites-available/, runs nginx -t, reloads nginx and adds HTTPS (certbot --nginx -d $DOMAIN${alias:+ -d $alias})."
    return
  fi
  step "6/7 Web server with HTTPS (Caddy)"
  mkdir -p "$WWW_DIR"
  sed -e "s#__DOMAIN__#$DOMAIN#g" -e "s#__ALIAS__#${alias:-__none__}#g" -e "s#__EMAIL__#$OWNER_EMAIL#g" \
      -e "s#__TLS__#${GILDSITE_TLS:+tls $GILDSITE_TLS}#g" "$INSTALLER_DIR/templates/Caddyfile.template" > "$WWW_DIR/Caddyfile"
  [ -n "$alias" ] || sed -i '/__none__/,/^}/d' "$WWW_DIR/Caddyfile"
  sed -e "s#__NAME__#$name#g" -e "s#__IP__#$sub.250#g" "$INSTALLER_DIR/templates/www-compose.yml" > "$WWW_DIR/docker-compose.yml"
  chmod 644 "$WWW_DIR/Caddyfile" "$WWW_DIR/docker-compose.yml"
  ( cd "$WWW_DIR" && logrun docker compose up -d ) || die "The web server did not start." "Ports 80 or 443 may be taken by another program (then: ./gildsite-install answer WEB_SERVER existing); check $LOG."
  ok "Caddy running for $DOMAIN${alias:+ (and $alias redirects to it)}"
}

run_backup() {
  local name dir; name=$(instance_name); dir=$(inst_dir)
  step "7/7 Nightly backup"
  if have systemctl && [ -d /run/systemd/system ]; then
    sudo_ tee /etc/systemd/system/gildsite-kopia-$name.service >/dev/null <<UNIT
[Unit]
Description=Gildsite nightly backup ($name)
[Service]
Type=oneshot
ExecStart=/bin/sh $dir/skrypty/kopia-nocna.sh
UNIT
    sudo_ tee /etc/systemd/system/gildsite-kopia-$name.timer >/dev/null <<UNIT
[Unit]
Description=Gildsite nightly backup ($name) at 3:30
[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true
[Install]
WantedBy=timers.target
UNIT
    sudo_ systemctl daemon-reload && sudo_ systemctl enable --now "gildsite-kopia-$name.timer" >> "$LOG" 2>&1 && ok "Backup every night at 3:30 (7 days kept)"
  else
    warn "No systemd here: nightly backup not scheduled. Run $dir/skrypty/kopia-nocna.sh by hand or from cron."
  fi
}

cmd_run() {
  need_consent; load_answers
  [ -n "$DOMAIN" ] && [ -n "$OWNER_EMAIL" ] && [ -n "$COMPANY" ] || die "Answers are missing." "Run ./gildsite-install plan."
  is_done dns || [ -n "${GILDSITE_SKIP_DNS:-}" ] || die "The website address does not point to this server yet." "Run ./gildsite-install dns and wait until it says DNS READY."
  mkdir -p "$STATE_DIR"; touch "$LOG"; chmod 600 "$LOG"
  say "Installing Gildsite. Details go to $LOG. Progress card: ./gildsite-install progress"
  ACTIVITY_ON=1; progress_set running 1 "starting"
  run_docker; run_source; run_deps; run_instance; run_production; run_www; run_backup
  mark_done run; progress_set done 8 "installed"; activity ok "Gildsite installed"
  say ""; say "INSTALLED. Next: ./gildsite-install finish"
}

cmd_key() {
  need_consent
  mkdir -p "$STATE_DIR"; local k; IFS= read -r k || true
  [ -n "$k" ] || die "No key given." "Pipe the key in: printf '%s' '<key>' | ./gildsite-install key"
  printf '%s' "$k" > "$KEY_FILE"; chmod 600 "$KEY_FILE"; say "Download key saved (not shown)."
}

cmd_finish() {
  need_consent; load_answers; ACTIVITY_ON=1
  is_done run || die "Gildsite is not installed yet." "Run ./gildsite-install run first."
  local name dir pd site panel; name=$(instance_name); dir=$(inst_dir); pd="$DOMAIN"
  local ip="${GILDSITE_TEST_IP:-127.0.0.1}" k="${GILDSITE_TLS:+-k}"
  site=$(curl -s --noproxy '*' $k -o /dev/null -w '%{http_code}' --resolve "$DOMAIN:443:$ip" "https://$DOMAIN/" || true)
  panel=$(curl -s --noproxy '*' $k -o /dev/null -w '%{http_code}' --resolve "$DOMAIN:443:$ip" "https://$DOMAIN/admin/login" || true)
  [ "$site" = 200 ] && ok "Website answers (https://$DOMAIN)" || bad "Website: HTTP $site"
  [ "$panel" = 200 ] && ok "Panel answers (https://$DOMAIN/admin)" || bad "Panel: HTTP $panel"
  { [ "$site" = 200 ] && [ "$panel" = 200 ]; } || die "Not everything answers yet." "Wait a minute and run ./gildsite-install finish again; if it stays, check $LOG."
  # One-time link: the owner sets their own password (no password ever goes through the chat).
  local token
  token=$(cd "$dir" && docker compose --profile narzedzia run --rm -T -e OWNER_EMAIL="$OWNER_EMAIL" -e TYLKO_LINK=1 narzedzia npx payload run tools/gildsite-install-wlasciciel.ts 2>/dev/null | sed -n 's/^LINK-TOKEN=//p' | tail -1)
  [ -n "$token" ] || die "Could not create the login link." "Check $LOG."
  mark_done finish
  say ""; say "DONE. Give the person this one-time link (valid 1 hour) to set their password:"
  say "  https://$pd/admin/reset/$token"
  say "After that they log in at https://$pd/admin and the panel guides them (Setup)."
}

# ---------- connections (steps "aurelius" and "github") ----------
# Both use the template's server command app/tools/serwer-polaczenia.ts (release 9cbf11d or newer). It writes the AI Access
# password only to a file (600) and logs every change in Security Log. Secrets never go through the chat or the command line
# of the panel: files in the instance folder dane/home (= /app/.home in the container), removed right after use.
AI_KEY_FILE="$STATE_DIR/ai-access-key"
GH_DIR="$STATE_DIR/gh"
GH_OUT="$STATE_DIR/github-login.out"
GH_PID="$STATE_DIR/github-login.pid"

need_tool() { [ -f "$(inst_dir)/app/tools/serwer-polaczenia.ts" ] || die "This Gildsite release cannot set up connections from the server yet." "Install a newer release (./gildsite-install answer RELEASE <tag>, then run), or set it up in the panel: Settings." 3; }
inst_uid() { grep '^UID_KLIENTA=' "$(inst_dir)/.env" | cut -d= -f2; }
connections() { # connections ENV...: run the server command in the tools container, output to the log and stdout (no secrets in it)
  local dir; dir=$(inst_dir)
  ( cd "$dir" && docker compose --profile narzedzia run --rm -T "$@" narzedzia npx payload run tools/serwer-polaczenia.ts 2>>"$LOG" | tee -a "$LOG" | grep -E '^(AI-ACCESS-ID|GITHUB)=|missing|must|There is no|does not exist' )
}
# The AI client belongs to the person who runs the AI (with sudo: that user, not root).
ai_user() { if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then echo "$SUDO_USER"; else id -un; fi; }
ai_home() { [ -n "${GILDSITE_AI_HOME:-}" ] && { echo "$GILDSITE_AI_HOME"; return; }; getent passwd "$(ai_user)" | cut -d: -f6; }
as_ai() { local u; u=$(ai_user); if [ "$u" = "$(id -un)" ]; then HOME="$(ai_home)" "$@"; else sudo -u "$u" -H "$@"; fi; }
as_ai_has() { as_ai sh -c "command -v $1" >/dev/null 2>&1; }

mcp_check() { # does the panel answer AI Access with this key? (header from a 600 file, never on the command line)
  local hf code ip="${GILDSITE_TEST_IP:-127.0.0.1}"; hf=$(mktemp); chmod 600 "$hf"
  printf 'Authorization: Bearer %s\n' "$(cat "$AI_KEY_FILE")" > "$hf"
  code=$(curl -s --noproxy '*' ${GILDSITE_TLS:+-k} -o /dev/null -w '%{http_code}' --resolve "$DOMAIN:443:$ip" -H @"$hf" \
    -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' \
    -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-03-26","capabilities":{},"clientInfo":{"name":"gildsite-install","version":"1"}}}' \
    "https://$DOMAIN/api/mcp" || true)
  rm -f "$hf"; echo "$code"
}

# Connector name: "gildsite"; when that name already points to another Gildsite (several instances on one server),
# this one gets "gildsite-<instance>" so nothing is overwritten.
CONNECTOR=gildsite
client_claude() {
  local url="$1" key cur; key=$(cat "$AI_KEY_FILE")
  cur=$(as_ai claude mcp get gildsite 2>/dev/null | sed -n 's/^ *URL: *//p' | head -1 || true)
  [ -n "$cur" ] && [ "$cur" != "$url" ] && CONNECTOR="gildsite-$(instance_name)"
  as_ai claude mcp remove "$CONNECTOR" -s user >/dev/null 2>&1 || true
  as_ai claude mcp add --transport http --scope user "$CONNECTOR" "$url" --header "Authorization: Bearer $key" >> "$LOG" 2>&1
}
client_codex() {
  local url="$1" f d; d="$(ai_home)/.codex"; f="$d/config.toml"
  as_ai mkdir -p "$d"; as_ai touch "$f"
  if awk '/^\[mcp_servers\.gildsite\]/{s=1;next} /^\[/{s=0} s && /^url/' "$f" | grep -q . && ! awk '/^\[mcp_servers\.gildsite\]/{s=1;next} /^\[/{s=0} s && /^url/' "$f" | grep -qF "\"$url\""; then CONNECTOR="gildsite-$(instance_name)"; fi
  # Replace our own block only; everything else in the file stays as it was.
  as_ai sh -c "awk 'BEGIN{s=0} /^\[mcp_servers\.$CONNECTOR\]/{s=1;next} /^\[/{s=0} !s' '$f' > '$f.tmp' && cat '$f.tmp' > '$f' && rm -f '$f.tmp' && chmod 600 '$f'"
  { printf '\n[mcp_servers.%s]\nurl = "%s"\nhttp_headers = { Authorization = "Bearer %s" }\n' "$CONNECTOR" "$url" "$(cat "$AI_KEY_FILE")"; } | as_ai sh -c "cat >> '$f'"
}

cmd_aurelius() {
  need_consent; load_answers; ACTIVITY_ON=1
  is_done run || die "Gildsite is not installed yet." "Run ./gildsite-install run first."
  need_tool
  local dir uid client="${1:-auto}" url="https://$DOMAIN/api/mcp" out code
  dir=$(inst_dir); uid=$(inst_uid)
  case "$client" in auto|claude|codex|none) ;; *) die "Unknown AI client \"$client\"." "Use: aurelius [claude|codex|none]";; esac
  step "Aurelius: AI Access key for the AI on this server"
  local hostfile="$dir/dane/home/.gildsite-ai-access"
  rm -f "$hostfile"; trap 'rm -f "'"$hostfile"'"' RETURN EXIT
  out=$(connections -e PLIK=/app/.home/.gildsite-ai-access -e NAZWA="Server AI (installer)" -e DNI="${GILDSITE_AI_DAYS:-90}") \
    || die "Creating the AI Access key failed: ${out:-see the log}." "Check $LOG. The panel keeps working; AI Access can also be set up in the panel."
  [ -s "$hostfile" ] || die "The AI Access key file was not written." "Check $LOG."
  install -m 600 "$hostfile" "$AI_KEY_FILE"; rm -f "$hostfile"
  ok "AI Access key ready (stored in $AI_KEY_FILE, not shown). $(echo "$out" | grep -o 'WAZNE-DO=[0-9-]*' | sed 's/WAZNE-DO=/valid until /')"
  ok "It can read and write drafts only; publishing stays a person's click"
  code=$(mcp_check); [ "$code" = 200 ] && ok "Panel answers AI Access at $url" || warn "AI Access answered HTTP $code (check again after DNS and HTTPS work)"
  if [ "$client" = auto ]; then if as_ai_has claude; then client=claude; elif as_ai_has codex; then client=codex; else client=none; fi; fi
  case "$client" in
    claude) client_claude "$url" || die "Adding the panel to Claude Code failed." "Check $LOG."; ok "Claude Code ($(ai_user)): panel added as connector \"$CONNECTOR\"" ;;
    codex)  client_codex "$url" || die "Adding the panel to Codex failed." "Check $LOG."; ok "Codex ($(ai_user)): panel added as connector \"$CONNECTOR\" in ~/.codex/config.toml" ;;
    none)   warn "No Claude Code or Codex found for $(ai_user). Add a connector by hand: address $url, header Authorization: Bearer <contents of $AI_KEY_FILE>." ;;
  esac
  mark_done aurelius
  say ""; say "AURELIUS CONNECTED${client:+ ($client)}. Start a new AI session so it sees the \"$CONNECTOR\" tools. Next: ./gildsite-install github (optional) or finish"
}

gh_() { env -u GH_TOKEN -u GITHUB_TOKEN GH_CONFIG_DIR="$GH_DIR" gh "$@"; }

cmd_github() {
  need_consent; load_answers; ACTIVITY_ON=1
  is_done run || die "Gildsite is not installed yet." "Run ./gildsite-install run first."
  need_tool
  [ -n "${GITHUB_REPO:-}" ] || die "No repository chosen yet." "Ask the person which GitHub repository should get feedback (owner/name), then ./gildsite-install answer GITHUB_REPO owner/name."
  if ! have gh; then step "GitHub: install the GitHub tool (gh)"; sudo_ apt-get install -y gh >> "$LOG" 2>&1 || die "Installing gh failed." "Check $LOG."; fi
  mkdir -p "$GH_DIR"; chmod 700 "$GH_DIR"
  if ! gh_ auth status -h github.com >/dev/null 2>&1; then
    # Device login: the person opens a GitHub page and types a short code. No token goes through the chat.
    if [ -f "$GH_PID" ] && kill -0 "$(cat "$GH_PID")" 2>/dev/null; then
      say "Still waiting for the person to confirm on GitHub."
    else
      : > "$GH_OUT"; chmod 600 "$GH_OUT"
      ( env -u GH_TOKEN -u GITHUB_TOKEN GH_CONFIG_DIR="$GH_DIR" nohup gh auth login -h github.com -p https --web --skip-ssh-key -s repo </dev/null >"$GH_OUT" 2>&1 & echo $! > "$GH_PID" )
      local i; for i in $(seq 1 20); do grep -q 'one-time code' "$GH_OUT" && break; sleep 1; done
    fi
    local codeline; codeline=$({ grep -o 'one-time code: [A-Z0-9-]*' "$GH_OUT" || true; } | tail -1 | sed 's/one-time code: //')
    [ -n "$codeline" ] || die "GitHub did not give a login code: $(tail -1 "$GH_OUT")." "Check the internet connection and run ./gildsite-install github again."
    say "GITHUB=WAITING"
    say "Ask the person to open https://github.com/login/device, sign in, type the code $codeline and allow access."
    say "Then run ./gildsite-install github again."
    return 4
  fi
  step "GitHub: connect the panel to $GITHUB_REPO"
  local dir uid tok out; dir=$(inst_dir); uid=$(inst_uid); tok="$dir/dane/home/.gildsite-gh-token"
  trap 'rm -f "'"$tok"'"' RETURN EXIT
  ( umask 077; gh_ auth token > "$tok" ) || die "Reading the GitHub login failed." "Run ./gildsite-install github again."
  chown "$uid:$uid" "$tok" 2>/dev/null || true
  out=$(connections -e GITHUB_TOKEN_PLIK=/app/.home/.gildsite-gh-token -e REPO="$GITHUB_REPO") || true
  rm -f "$tok"
  case "$out" in
    *GITHUB=polaczono*) ;;
    *) die "GitHub refused: $(echo "$out" | sed -n 's/^GITHUB=blad //p' | head -1)" "Check the repository name and that this GitHub account can open issues there, then run ./gildsite-install github again." ;;
  esac
  # The panel now keeps its own encrypted copy; the installer does not keep a second one.
  gh_ auth logout -h github.com >/dev/null 2>&1 || true; rm -rf "$GH_DIR" "$GH_OUT" "$GH_PID"
  mark_done github
  ok "Panel connected to GitHub: $GITHUB_REPO (feedback goes there as issues)"
  say ""; say "GITHUB CONNECTED. Next: ./gildsite-install finish"
}

# ---------- progress card ("progress") ----------
# The installer keeps a small state file while it works; `progress` turns it into a card the AI shows in the chat:
# text for terminals (Claude Code, Codex), --html for chats that draw HTML widgets, --json for anything else.
# Only the installer's own messages go into it, never raw build logs, so no secret can leak through the card.
PROGRESS="$STATE_DIR/progress.env"
ACTIVITY="$STATE_DIR/activity.log"
RUN_STEPS=("Docker" "Gildsite code" "Libraries" "Website and panel" "Production settings and owner" "Web server and HTTPS" "Nightly backup")
RUN_MIN=(2 2 4 12 6 1 1)   # rough minutes per part, for "about N min left"

activity() { [ -n "${ACTIVITY_ON:-}" ] || return 0; mkdir -p "$STATE_DIR"; printf '%s|%s|%s\n' "$(date -u +%H:%M)" "$1" "$2" >> "$ACTIVITY"; chmod 600 "$ACTIVITY" 2>/dev/null || true; }
progress_set() { [ -n "${ACTIVITY_ON:-}" ] || return 0; mkdir -p "$STATE_DIR"; { printf 'P_STATE=%q\nP_STEP=%q\nP_MSG=%q\nP_AT=%q\n' "$1" "${2:-0}" "${3:-}" "$(date -u +%s)"; } > "$PROGRESS.tmp"; mv "$PROGRESS.tmp" "$PROGRESS"; }

progress_data() { # fills the P_* and C_* variables the three formats print
  load_answers; P_STATE=idle; P_STEP=0; P_MSG=""; P_AT=0; [ -f "$PROGRESS" ] && . "$PROGRESS"
  C_ITEMS=(); local n=0 s
  add() { C_ITEMS+=("$1|$2|$3"); }
  [ -n "$DOMAIN" ] && [ -n "$OWNER_EMAIL" ] && [ -n "$COMPANY" ] && s=done || s=todo; add "Your answers" "$s" "Address, owner e-mail, company"
  [ -f "$CONSENT" ] && s=done || s=todo; add "Your yes to the plan" "$s" ""
  { is_done dns || [ -n "${GILDSITE_SKIP_DNS:-}" ]; } && s=done || s=todo; add "Address points to this server" "$s" "${DOMAIN}"
  local i
  for i in "${!RUN_STEPS[@]}"; do
    if { [ "$P_STATE" != running ] && [ "$P_STATE" != failed ] && is_done run; } || { [ "$P_STATE" != idle ] && [ "$P_STEP" -gt $((i+1)) ]; }; then s=done
    elif [ "$P_STATE" = running ] && [ "$P_STEP" -eq $((i+1)) ]; then s=now
    elif [ "$P_STATE" = failed ] && [ "$P_STEP" -eq $((i+1)) ]; then s=failed
    else s=todo; fi
    add "${RUN_STEPS[$i]}" "$s" ""
  done
  is_done aurelius && s=done || s=todo; add "Connect Aurelius (optional)" "$s" ""
  is_done finish && s=done || s=todo; add "Login link for the owner" "$s" ""
  C_TOTAL=${#C_ITEMS[@]}; C_DONE=0; C_NOW=""
  for s in "${C_ITEMS[@]}"; do case "$s" in *"|done|"*) C_DONE=$((C_DONE+1));; *"|now|"*|*"|failed|"*) [ -n "$C_NOW" ] || C_NOW="${s%%|*}";; esac; done
  C_PCT=$(( C_DONE * 100 / C_TOTAL ))
  C_LEFT=0; if [ "$P_STATE" = running ] || ! is_done run; then for i in "${!RUN_MIN[@]}"; do [ "$P_STEP" -le $((i+1)) ] && C_LEFT=$((C_LEFT + RUN_MIN[i])); done; fi
  local mt ma; mt=$(awk '/MemTotal/{print $2}' /proc/meminfo); ma=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
  C_RAM_USED=$(awk -v t="$mt" -v a="$ma" 'BEGIN{printf "%.1f", (t-a)/1048576}'); C_RAM_TOTAL=$(awk -v t="$mt" 'BEGIN{printf "%.0f", t/1048576}')
  C_RAM_PCT=$(( (mt-ma) * 100 / mt ))
  local p="$GILDSITE_HOME"; while [ ! -d "$p" ]; do p=$(dirname "$p"); done
  read -r C_DISK_TOTAL C_DISK_USED < <(df -BG --output=size,used "$p" | tail -1 | tr -d G)
  C_DISK_PCT=$(( C_DISK_USED * 100 / (C_DISK_TOTAL > 0 ? C_DISK_TOTAL : 1) ))
  if is_done run; then [ "$WEB_SERVER" = existing ] && C_HTTPS="set up by the server admin" || C_HTTPS="on (Caddy)"; else C_HTTPS="not yet"; fi
  C_LAST=(); [ -f "$ACTIVITY" ] && mapfile -t C_LAST < <(tail -3 "$ACTIVITY")
  if [ "$P_STATE" = failed ]; then C_MOVE="Something stopped: ${P_MSG}. I will explain what to do."
  elif [ -z "$DOMAIN" ] || [ -z "$OWNER_EMAIL" ] || [ -z "$COMPANY" ]; then C_MOVE="Answer three short questions in the chat."
  elif [ ! -f "$CONSENT" ]; then C_MOVE="Read the plan and say yes or no."
  elif ! is_done dns && [ -z "${GILDSITE_SKIP_DNS:-}" ]; then C_MOVE="Add one DNS record at your domain provider (see the chat)."
  elif [ "$P_STATE" = running ]; then C_MOVE="Nothing. You can close this; I will write when it is done."
  elif is_done finish; then C_MOVE="Open your one-time login link and set a password."
  else C_MOVE="Nothing for now."; fi
  C_AGO=$(( $(date -u +%s) - P_AT )); [ "$P_AT" -gt 0 ] || C_AGO=-1
}

bar() { local pct=$1 w=${2:-24} f; f=$(( pct * w / 100 )); printf '%*s' "$f" '' | tr ' ' '#'; printf '%*s' $((w-f)) '' | tr ' ' '.'; }

progress_text() {
  local s name st det mark i=1 head
  case "$P_STATE" in running) head="Installing Gildsite";; failed) head="Gildsite: stopped";; *) is_done finish && head="Gildsite is ready" || head="Gildsite installer";; esac
  printf '%s  ·  %s\n' "$head" "${DOMAIN:-address not set}"
  printf '[%s] %d%%  ·  %d of %d done%s\n\n' "$(bar "$C_PCT")" "$C_PCT" "$C_DONE" "$C_TOTAL" "$( [ "$C_LEFT" -gt 0 ] && [ "$P_STATE" = running ] && echo "  ·  about $C_LEFT min left" )"
  for s in "${C_ITEMS[@]}"; do
    IFS='|' read -r name st det <<< "$s"
    case "$st" in done) mark="[x]";; now) mark="[>]";; failed) mark="[!]";; *) mark="[ ]";; esac
    printf ' %s %2d. %s%s\n' "$mark" "$i" "$name" "$( [ "$st" = now ] && echo '  (working now)' )"; i=$((i+1))
  done
  printf '\nServer   memory %s of %s GB  ·  disk %s of %s GB  ·  HTTPS %s\n' "$C_RAM_USED" "$C_RAM_TOTAL" "$C_DISK_USED" "$C_DISK_TOTAL" "$C_HTTPS"
  if [ ${#C_LAST[@]} -gt 0 ]; then printf 'Lately\n'; for s in "${C_LAST[@]}"; do IFS='|' read -r i st det <<< "$s"; printf '  %s  %s\n' "$i" "$det"; done; fi
  printf 'Your move: %s\n' "$C_MOVE"
}

esc() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e "s/'/\&#39;/g" -e 's/"/\&quot;/g'; }

progress_html() { # fragment for chat widgets; colours only through the chat's own theme variables
  local s name st det i=1 rows="" last="" head
  case "$P_STATE" in running) head="Installing Gildsite";; failed) head="Gildsite: stopped";; *) is_done finish && head="Gildsite is ready" || head="Gildsite installer";; esac
  for s in "${C_ITEMS[@]}"; do
    IFS='|' read -r name st det <<< "$s"
    rows+="<li class='$st'><span class='ic'>$( case "$st" in done) echo '&#10003;';; failed) echo '!';; now) echo '';; *) echo "$i";; esac )</span><span>$(esc "$name")$( [ "$st" = now ] && echo " <em>working now</em>" || true )</span></li>"; i=$((i+1))
  done
  for s in "${C_LAST[@]}"; do IFS='|' read -r i st det <<< "$s"; last+="<div><span class='mu'>$(esc "$i")</span> $(esc "$det")</div>"; done
  cat <<HTML
<style>.gp{font:14px/1.45 system-ui,sans-serif;color:var(--text-primary);background:var(--surface-1);border:1px solid var(--border);border-radius:14px;padding:16px;max-width:620px}
.gp h3{margin:0;font-size:15px}.gp .mu{color:var(--text-secondary);font-size:12px}.gp .bar{height:8px;border-radius:99px;background:var(--border);margin:12px 0 4px;overflow:hidden}
.gp .bar i{display:block;height:100%;background:var(--text-accent)}.gp .cols{display:grid;grid-template-columns:1.2fr 1fr;gap:14px;margin-top:12px}
@media(max-width:520px){.gp .cols{grid-template-columns:1fr}}.gp ol{list-style:none;margin:0;padding:0}.gp li{display:flex;gap:8px;align-items:center;padding:4px 0}
.gp .ic{width:18px;height:18px;border-radius:50%;border:1.5px solid var(--border);display:grid;place-items:center;font-size:11px;color:var(--text-muted)}
.gp .done .ic{background:var(--text-success);border-color:var(--text-success);color:var(--surface-1)}.gp .done{color:var(--text-secondary)}
.gp .now .ic{border-color:var(--text-accent)}.gp .now .ic::after{content:'';width:8px;height:8px;border-radius:50%;background:var(--text-accent)}
.gp .failed .ic{border-color:var(--text-danger);color:var(--text-danger)}.gp .todo{color:var(--text-muted)}.gp em{color:var(--text-accent);font-style:normal;font-size:12px}
.gp .box{border:1px solid var(--border);border-radius:10px;padding:8px 10px;margin-bottom:8px;font-size:13px}.gp .lab{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--text-muted)}
.gp .mv{color:var(--text-warning)}</style>
<div class='gp'><h3>$(esc "$head")</h3><div class='mu'>$(esc "${DOMAIN:-address not set}")$( [ "$C_AGO" -ge 0 ] && echo " · updated ${C_AGO}s ago" )</div>
<div class='bar'><i style='width:${C_PCT}%'></i></div><div class='mu'>${C_DONE} of ${C_TOTAL} done · ${C_PCT}%$( [ "$C_LEFT" -gt 0 ] && [ "$P_STATE" = running ] && echo " · about ${C_LEFT} min left" )</div>
<div class='cols'><ol>${rows}</ol><div>
<div class='box'><div class='lab'>Server</div>Memory ${C_RAM_USED} of ${C_RAM_TOTAL} GB<div class='bar'><i style='width:${C_RAM_PCT}%'></i></div>Disk ${C_DISK_USED} of ${C_DISK_TOTAL} GB<div class='bar'><i style='width:${C_DISK_PCT}%'></i></div>HTTPS: $(esc "$C_HTTPS")</div>
$( [ -n "$last" ] && echo "<div class='box'><div class='lab'>Lately</div>${last}</div>" )
<div class='box'><div class='lab'>Your move</div><span class='mv'>$(esc "$C_MOVE")</span></div></div></div></div>
HTML
}

json_s() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
progress_json() {
  local s name st det first=1
  printf '{"state":"%s","domain":"%s","done":%d,"total":%d,"percent":%d,"minutes_left":%d,"your_move":"%s","https":"%s","memory_gb":{"used":%s,"total":%s},"disk_gb":{"used":%s,"total":%s},"steps":[' \
    "$P_STATE" "$(json_s "$DOMAIN")" "$C_DONE" "$C_TOTAL" "$C_PCT" "$C_LEFT" "$(json_s "$C_MOVE")" "$(json_s "$C_HTTPS")" "$C_RAM_USED" "$C_RAM_TOTAL" "$C_DISK_USED" "$C_DISK_TOTAL"
  for s in "${C_ITEMS[@]}"; do IFS='|' read -r name st det <<< "$s"; [ $first = 1 ] || printf ','; first=0; printf '{"name":"%s","status":"%s"}' "$(json_s "$name")" "$st"; done
  printf ']}\n'
}

cmd_progress() {
  progress_data
  case "${1:-}" in --html) progress_html ;; --json) progress_json ;; *) progress_text ;; esac
}

cmd_status() {
  load_answers
  say "Gildsite installer $VERSION: status"
  local i=1 s name desc mark
  for s in "${STEPS[@]}"; do
    name=${s%%|*}; desc=${s#*|}; mark="[ ]"
    case "$name" in
      check)   ( cmd_check >/dev/null 2>&1 ) && mark="[x]" ;;
      answers) [ -n "$DOMAIN" ] && [ -n "$OWNER_EMAIL" ] && [ -n "$COMPANY" ] && mark="[x]" ;;
      consent) [ -f "$CONSENT" ] && mark="[x]" ;;
      *)       is_done "$name" && mark="[x]" ;;
    esac
    printf '  %s %d. %s\n' "$mark" "$i" "$desc"; i=$((i+1))
  done
}

usage() {
  cat <<USE
Gildsite installer $VERSION. Read INSTALL-FOR-AI.md first.

  check [--json]        look at the server (read-only)
  answer KEY VALUE      save DOMAIN, OWNER_EMAIL, COMPANY (also DESIGN on|off, RELEASE, INSTANCE)
  plan                  show what will happen (read-only)
  consent yes           record the person's yes (only after they said it)
  dns                   show DNS records and check them (read-only)
  key                   save the download key from input (needs consent; never print it)
  run                   install and start everything (needs consent)
  aurelius [claude|codex|none]  connect Aurelius to the AI on this server (needs consent)
  github                connect GitHub (needs consent and answer GITHUB_REPO; run again after the person confirms)
  finish                final check and owner login link (needs consent)
  status                which steps are done
  progress [--html|--json]  progress card for the chat (text, HTML widget or data)
USE
}

case "${1:-}" in
  check)    shift; cmd_check "${1:-}" ;;
  answer)   shift; cmd_answer "${1:-}" "${2:-}" ;;
  plan)     cmd_plan ;;
  consent)  shift; cmd_consent "${1:-}" ;;
  dns)      cmd_dns ;;
  run)      cmd_run ;;
  key)      cmd_key ;;
  finish)   cmd_finish ;;
  aurelius) shift; cmd_aurelius "${1:-}" ;;
  github)   cmd_github ;;
  status)   cmd_status ;;
  progress) shift; cmd_progress "${1:-}" ;;
  version)  say "$VERSION" ;;
  ""|help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
