#!/usr/bin/env bash
# Gildsite installer. Run by an AI on the server, which talks to the person (see INSTALL-FOR-AI.md).
# Read-only commands: check, plan, status, dns, docker-help, ai. Everything that changes the server needs `consent yes` first.
set -euo pipefail
umask 077
# Started from a service or a background job, the shell may have no HOME and a short PATH: git (trusted folders),
# Claude Code and Codex then look for their settings in the wrong place. Take HOME from the account itself.
[ -n "${HOME:-}" ] || HOME=$(getent passwd "$(id -u)" | cut -d: -f6); export HOME="${HOME:-/root}"
case ":$PATH:" in *:/bin:*) ;; *) PATH="$PATH:/bin";; esac; export PATH

VERSION="0.10.0"
INSTALLER_DIR="$(cd "$(dirname "$0")" && pwd)"

# What kind of machine this is: mac, wsl (Windows with WSL), linux, windows (Windows without WSL) or other.
computer_kind() {
  case "$(uname -s)" in
    Darwin) echo mac ;;
    Linux) if grep -qi microsoft /proc/version 2>/dev/null; then echo wsl; else echo linux; fi ;;
    MINGW*|MSYS*|CYGWIN*) echo windows ;;
    *) echo other ;;
  esac
}
# Where the installer keeps its files. A server: /srv/gildsite, as always (an existing installation is found there first).
# A person's own computer (TARGET local): ~/gildsite, because a Mac or a normal account cannot write to /srv.
HOME_AUTO=""
if [ -z "${GILDSITE_HOME:-}" ]; then
  HOME_AUTO=1
  if [ -d /srv/gildsite/.install ]; then GILDSITE_HOME=/srv/gildsite
  elif [ -d "$HOME/gildsite/.install" ]; then GILDSITE_HOME="$HOME/gildsite"
  else case "$(computer_kind)" in mac|windows) GILDSITE_HOME="$HOME/gildsite" ;; *) GILDSITE_HOME=/srv/gildsite ;; esac; fi
fi
[ -z "${GILDSITE_STATE_DIR:-}" ] || HOME_AUTO=""
set_home() {
  GILDSITE_HOME="$1"; STATE_DIR="${GILDSITE_STATE_DIR:-$GILDSITE_HOME/.install}"
  ANSWERS="$STATE_DIR/answers.env"; CONSENT="$STATE_DIR/consent"; DONE_DIR="$STATE_DIR/done"
}
set_home "$GILDSITE_HOME"

# Until ready-made Docker images exist, the panel is built on the server; that build needs about 8 GB of memory.
MIN_RAM_GB="${MIN_RAM_GB:-8}"
MIN_DISK_GB="${MIN_DISK_GB:-30}"

STEPS=(
  "check|Look at the server (memory, disk, ports, Docker)"
  "answers|Save the website address, owner e-mail and company name"
  "ai|Your AI: choose it and log in (Claude recommended)"
  "consent|Get the person's yes for the plan"
  "dns|Point the address to this server"
  "run|Install and start Gildsite in Docker, HTTPS, nightly backups"
  "aurelius|Connect Aurelius to the AI on this server (optional)"
  "github|Connect GitHub for issues and pull requests (optional)"
  "finish|Check everything answers, give the owner a login link"
)

# ---------- helpers ----------
say()   { printf '%s\n' "$*"; }
ok()    { printf '  OK    %s\n' "$*"; activity ok "$*"; }
warn()  { printf '  WARN  %s\n' "$*"; activity warn "$*"; }
bad()   { printf '  FAIL  %s\n' "$*"; }
die()   { printf 'ERROR: %s\nFIX: %s\n' "$1" "${2:-Run ./gildsite-install status and tell the person what is missing.}" >&2
          [ -n "${ACTIVITY_ON:-}" ] && { activity error "$1"; progress_set failed "${RUN_STEP:-0}" "$1"; }; exit "${3:-1}"; }
have()  { command -v "$1" >/dev/null 2>&1; }

default_target() { case "$(computer_kind)" in mac|windows) echo local ;; *) echo server ;; esac; }
load_answers() { [ -f "$ANSWERS" ] && . "$ANSWERS"; TARGET="${TARGET:-$(default_target)}"; PUBLISH="${PUBLISH:-}"; DOMAIN="${DOMAIN:-}"; OWNER_EMAIL="${OWNER_EMAIL:-}"; COMPANY="${COMPANY:-}"; DESIGN="${DESIGN:-off}"; RELEASE="${RELEASE:-latest}"; INSTANCE="${INSTANCE:-}"; GITHUB_REPO="${GITHUB_REPO:-}"; WEB_SERVER="${WEB_SERVER:-caddy}"; JOBS="${JOBS:-backup,knowledge}"; OWNER_LINK="${OWNER_LINK:-yes}"; [ "${GILDSITE_WWW:-}" = none ] && WEB_SERVER=existing
  AI="${AI:-}"; AI_URL="${AI_URL:-}"; AI_NAME="${AI_NAME:-}"; AI_LOGIN="${AI_LOGIN:-$(ai_default_login "$AI")}"
  [ "$AI_LOGIN" = window ] && ! ai_window_ok "$AI" && AI_LOGIN=key; true; }
need_consent() { [ -f "$CONSENT" ] || die "The person has not agreed to the plan yet." "Run ./gildsite-install plan, explain it, and after a clear yes run ./gildsite-install consent yes." 2; }
mark_done() { mkdir -p "$DONE_DIR"; date -u +%FT%TZ > "$DONE_DIR/$1"; }
is_done() { [ -f "$DONE_DIR/$1" ]; }

ram_gb()  { awk '/MemTotal/ {printf "%d", $2/1024/1024 + 0.5}' /proc/meminfo 2>/dev/null || echo 0; }
disk_gb() { local p="$GILDSITE_HOME"; while [ ! -d "$p" ]; do p=$(dirname "$p"); done; df -BG --output=avail "$p" | tail -1 | tr -dc 0-9; }
port_busy() { have ss && ss -ltnH "( sport = :$1 )" 2>/dev/null | grep -q .; }
public_ip() { curl -fsS --max-time 5 https://api.ipify.org 2>/dev/null || { hostname -I 2>/dev/null || true; } | awk '{print $1}'; }
resolve() { { getent ahostsv4 "$1" 2>/dev/null || true; } | awk 'NR==1 {print $1}'; }

# ---------- commands ----------
cmd_check() {
  load_answers
  [ "$TARGET" = local ] && { check_local "${1:-}"; return; }
  local fails=0 json="${1:-}"
  local os="unknown" arch ram disk
  [ -f /etc/os-release ] && os=$(. /etc/os-release; echo "$ID $VERSION_ID")
  arch=$(uname -m); ram=$(ram_gb); disk=$(disk_gb)
  local ais=() a; for a in claude codex gemini opencode; do have "$a" && ais+=("$a"); done

  if [ "$json" = "--json" ]; then
    printf '{"os":"%s","arch":"%s","ram_gb":%s,"disk_free_gb":%s,"docker":%s,"port80_busy":%s,"port443_busy":%s,"root":%s,"ai_clients":"%s","gh":%s}\n' \
      "$os" "$arch" "$ram" "$disk" "$(have docker && echo true || echo false)" \
      "$(port_busy 80 && echo true || echo false)" "$(port_busy 443 && echo true || echo false)" \
      "$([ "$(id -u)" = 0 ] && echo true || echo false)" "${ais[*]:-}" "$(have gh && echo true || echo false)"
    return 0
  fi

  say "Gildsite installer $VERSION: server check (nothing is changed)"
  case "$os" in ubuntu*|debian*) ok "System: $os" ;; *) warn "System: $os (tested on Ubuntu and Debian)";; esac
  case "$arch" in x86_64|aarch64) ok "Processor: $arch" ;; *) bad "Processor: $arch is not supported"; fails=$((fails+1));; esac
  if [ "$ram" -ge "$MIN_RAM_GB" ]; then ok "Memory: ${ram} GB"; else bad "Memory: ${ram} GB, needs at least ${MIN_RAM_GB} GB"; fails=$((fails+1)); fi
  if [ "$disk" -ge "$MIN_DISK_GB" ]; then ok "Free disk: ${disk} GB"; else bad "Free disk: ${disk} GB, needs at least ${MIN_DISK_GB} GB"; fails=$((fails+1)); fi
  if [ "$(id -u)" = 0 ] || (have sudo && sudo -n true 2>/dev/null); then ok "Admin rights: yes"; else bad "Admin rights: no (run as root or with sudo)"; fails=$((fails+1)); fi
  if have docker; then ok "Docker: $(docker --version 2>/dev/null | cut -d, -f1)"; else warn "Docker: not installed yet (the installer will add it)"; fi
  local p; for p in 80 443; do
    if port_busy "$p"; then warn "Port $p is used by another program. The installer will not take it over; answer WEB_SERVER existing to keep the current web server."; else ok "Port $p: free"; fi
  done
  if [ ${#ais[@]} -gt 0 ]; then ok "AI on this server: ${ais[*]} (Aurelius can connect to it)"; else warn "AI on this server: none found (Aurelius can still use an API key in the panel)"; fi
  if have gh; then ok "GitHub tool: installed"; else warn "GitHub tool: not installed (optional, the installer can add it)"; fi
  say ""
  if [ "$fails" -eq 0 ]; then say "READY: the server can run Gildsite."; else say "NOT READY: $fails problem(s) above."; return 1; fi
}

# ---------- the person's own computer (TARGET local) ----------
# Mac, Windows with WSL or Linux. Docker is never installed by the script on a computer: the person installs Docker
# Desktop (or Docker on Linux) with the step-by-step guide from `docker-help`. Everything listens on 127.0.0.1 only.
# shellcheck disable=SC1091 # /etc/os-release exists only on Linux
computer_name() { case "$(computer_kind)" in mac) echo "Mac (macOS $(sw_vers -productVersion 2>/dev/null || echo '?'))" ;; wsl) echo "Windows with WSL ($(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-Linux}"))" ;; linux) echo "Linux ($(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-unknown}"))" ;; windows) echo "Windows without WSL" ;; *) uname -s ;; esac; }
free_ram_gb() { # memory free for new programs now, in whole GB (rounded down)
  if [ -r /proc/meminfo ]; then awk '/MemAvailable/ {printf "%d", $2/1024/1024}' /proc/meminfo
  elif have vm_stat; then vm_stat | awk -v ps="$(sysctl -n hw.pagesize 2>/dev/null || echo 4096)" \
      '/Pages (free|inactive|speculative)/ {gsub(/\./,"",$NF); p+=$NF} END {printf "%d", p*ps/1024/1024/1024}'
  else echo 0; fi
}
free_disk_gb() { local p="$GILDSITE_HOME"; while [ ! -d "$p" ]; do p=$(dirname "$p"); done; df -Pk "$p" | awk 'NR==2 {printf "%d", $4/1024/1024}'; }
# Docker: "running", "no-access" (installed, but this account may not use it), "stopped" or "missing".
docker_state() {
  have docker || { echo missing; return; }
  local e; e=$(docker info 2>&1 >/dev/null) && { echo running; return; }
  case "$e" in *ermission*) echo no-access ;; *) echo stopped ;; esac
}
docker_mem_gb() { docker info --format '{{.MemTotal}}' 2>/dev/null | awk '{printf "%d", $1/1024/1024/1024 + 0.5}'; }

check_local() {
  local fails=0 json="${1:-}" kind arch ram disk dk dmem="" ais=() a
  kind=$(computer_kind); arch=$(uname -m); ram=$(free_ram_gb); disk=$(free_disk_gb); dk=$(docker_state)
  [ "$dk" = running ] && dmem=$(docker_mem_gb)
  for a in claude codex gemini opencode; do have "$a" && ais+=("$a"); done
  if [ "$json" = "--json" ]; then
    printf '{"target":"local","computer":"%s","arch":"%s","ram_free_gb":%s,"disk_free_gb":%s,"docker":"%s","docker_memory_gb":%s,"ai_clients":"%s"}\n' \
      "$kind" "$arch" "${ram:-0}" "${disk:-0}" "$dk" "${dmem:-0}" "${ais[*]:-}"
    return 0
  fi
  say "Gildsite installer $VERSION: computer check (nothing is changed)"
  case "$kind" in
    mac|wsl|linux) ok "Computer: $(computer_name)" ;;
    windows) bad "Computer: Windows without WSL. Gildsite runs in WSL (Ubuntu inside Windows); ./gildsite-install docker-help shows how to get it"; fails=$((fails+1)) ;;
    *) bad "Computer: $(uname -s) is not supported (Mac, Windows with WSL or Linux)"; fails=$((fails+1)) ;;
  esac
  case "$arch" in x86_64|aarch64|arm64) ok "Processor: $arch" ;; *) bad "Processor: $arch is not supported"; fails=$((fails+1)) ;; esac
  if [ "${ram:-0}" -ge "$MIN_RAM_GB" ]; then ok "Free memory: ${ram} GB"
  else bad "Free memory: ${ram:-0} GB, needs ${MIN_RAM_GB} GB free (close big programs, or see ./gildsite-install docker-help)"; fails=$((fails+1)); fi
  if [ "${disk:-0}" -ge "$MIN_DISK_GB" ]; then ok "Free disk: ${disk} GB"; else bad "Free disk: ${disk:-0} GB, needs at least ${MIN_DISK_GB} GB"; fails=$((fails+1)); fi
  case "$dk" in
    running) ok "Docker: running ($(docker --version 2>/dev/null | cut -d, -f1))"
             if [ -n "$dmem" ] && [ "$dmem" -lt "$MIN_RAM_GB" ]; then bad "Docker may use only ${dmem} GB of memory, needs ${MIN_RAM_GB} GB (Docker Desktop: Settings, Resources, Memory)"; fails=$((fails+1)); fi ;;
    no-access) bad "Docker: installed, but this account may not use it (./gildsite-install docker-help, part \"no access\")"; fails=$((fails+1)) ;;
    stopped) bad "Docker: installed but not running. Start Docker Desktop (or Docker) and check again"; fails=$((fails+1)) ;;
    *) bad "Docker: not installed. The installer does not install it on a computer; guide the person with ./gildsite-install docker-help"; fails=$((fails+1)) ;;
  esac
  if [ ${#ais[@]} -gt 0 ]; then ok "AI on this computer: ${ais[*]} (Aurelius can connect to it)"; else warn "AI on this computer: none found (Aurelius can still use an API key in the panel)"; fi
  say ""
  if [ "$fails" -eq 0 ]; then say "READY: this computer can run Gildsite."; else say "NOT READY: $fails problem(s) above."; return 1; fi
}

cmd_docker_help() { # read-only: step-by-step Docker guide for this computer, for the AI to retell one step at a time
  load_answers
  local kind; kind=$(computer_kind)
  say "Docker on this computer: $(computer_name). Nothing is changed by this command."
  say "Tell the person one step at a time and wait for \"done\" after each. Then run ./gildsite-install check again."
  say ""
  case "$kind" in
    mac) cat <<'HELP'
1. Open https://www.docker.com/products/docker-desktop/ and download Docker Desktop for Mac.
   Pick "Apple Silicon" when the processor is arm64, "Intel" when it is x86_64 (./gildsite-install check shows it).
2. Open the downloaded file and drag Docker to Applications.
3. Start Docker from Applications, accept the terms. Signing in is not needed ("Skip" or "Continue without signing in").
4. Wait until the whale icon at the top of the screen says "Docker Desktop is running".
5. Docker settings (gear icon), Resources, Memory: at least 8 GB. Click "Apply & restart".
HELP
    ;;
    wsl) cat <<'HELP'
1. In Windows (not in this window) open https://www.docker.com/products/docker-desktop/ and download Docker Desktop for Windows.
2. Install it with the "Use WSL 2" option on. Restart Windows if it asks.
3. Start Docker Desktop, accept the terms. Signing in is not needed.
4. Docker Desktop settings, Resources, WSL integration: turn it on for this Linux (for example Ubuntu). Click "Apply & restart".
5. Close this window and open it again, so it sees Docker.
Too little free memory: WSL gets only part of the computer's memory. In Windows, the file .wslconfig in the user folder
(C:\Users\<name>\.wslconfig) with the two lines
   [wsl2]
   memory=10GB
then in PowerShell: wsl --shutdown, and open this window again.
HELP
    ;;
    windows) cat <<'HELP'
Gildsite runs in WSL (a small Linux inside Windows), not directly in Windows.
1. Open PowerShell as administrator (Start, type PowerShell, right click, Run as administrator).
2. Type: wsl --install   and press Enter. Restart Windows when it is done.
3. Open "Ubuntu" from the Start menu, choose a user name and password (this is the Linux account, not a website password).
4. Start the AI in that Ubuntu window and the installation from there: the guide then continues with Docker Desktop.
HELP
    ;;
    *) cat <<'HELP'
Docker Engine on Linux. The person types these in their own terminal (it asks for their computer password):
1. curl -fsSL https://get.docker.com | sudo sh
2. sudo usermod -aG docker "$USER"
3. Log out and log in again (or restart the computer), so the account may use Docker.
Instead of the above, Docker Desktop for Linux works too: https://docs.docker.com/desktop/setup/install/linux/
HELP
    ;;
  esac
  say ""
  say "No access: when check says this account may not use Docker, step 2 and 3 of the Linux guide fix it (on a Mac: restart Docker Desktop)."
}

# ---------- your AI (step "ai") ----------
# The person picks the AI that Aurelius talks to: Claude (recommended, Aurelius's engine is Claude Code), OpenAI, Gemini,
# Grok, or another provider with an API key or a model on their own machine. Two ways to log in: the provider's own login
# window (Claude Code, Codex, Gemini CLI), or an API key the person types into the installer's secure field (ai-key:
# hidden input, kept in a file only this account can read). A key never goes through the chat, the command line, the log
# or git. The choice (never the key) is written to ai.json; on an installed server also into the instance, for the panel.
AI_PROVIDER_KEY="$STATE_DIR/ai-provider-key"
AI_CHOICE="$STATE_DIR/ai.json"

ai_known() { case "$1" in claude|openai|gemini|grok|other) return 0 ;; *) return 1 ;; esac; }
ai_default_login() { case "$1" in claude|openai|gemini) echo window ;; grok|other) echo key ;; *) echo "" ;; esac; }
ai_window_ok() { case "$1" in claude|openai|gemini) return 0 ;; *) return 1 ;; esac; }
ai_name() { case "$AI" in claude) echo Claude ;; openai) echo OpenAI ;; gemini) echo Gemini ;; grok) echo Grok ;; other) echo "${AI_NAME:-Other AI}" ;; *) echo "no AI chosen" ;; esac; }
ai_panel_slug() { case "$AI" in grok) echo xai ;; *) echo "$AI" ;; esac; } # the panel's own names (Connectors, AI models)
ai_cli() { case "$AI" in claude) echo claude ;; openai) echo codex ;; gemini) echo gemini ;; esac; }
ai_plan_line() {
  local how; if [ "$AI_LOGIN" = window ]; then how="login in the provider's own window"; else how="API key in the installer's secure field"; fi
  [ "$AI" = other ] && [ -n "$AI_URL" ] && how="$how, address $AI_URL"
  printf '%s%s (%s)' "$(ai_name)" "$( [ "$AI" = claude ] && echo ", recommended" )" "$how"
}
ai_honest() { echo "Gildsite works best with Claude: Aurelius's engine is Claude Code. $(ai_name) gets the same rules and panel tools, but some skills may work less well."; }
ai_base() { case "$AI" in claude) echo https://api.anthropic.com/v1 ;; openai) echo https://api.openai.com/v1 ;; gemini) echo https://generativelanguage.googleapis.com/v1beta/openai ;; grok) echo https://api.x.ai/v1 ;; other) echo "${AI_URL%/}" ;; esac; }
ai_where_key() { case "$AI" in claude) echo "Claude Console, API keys (https://platform.claude.com/settings/keys)" ;; openai) echo "OpenAI Platform, API keys (https://platform.openai.com/api-keys)" ;; gemini) echo "Google AI Studio, Get API key (https://aistudio.google.com/apikey)" ;; grok) echo "xAI Console, API Keys (https://console.x.ai)" ;; *) echo "the provider's API keys page" ;; esac; }
ai_install_cli() { case "$AI" in claude) echo "curl -fsSL https://claude.ai/install.sh | bash" ;; openai) echo "npm install -g @openai/codex" ;; gemini) echo "npm install -g @google/gemini-cli" ;; esac; }
ai_window_how() { case "$AI" in
  claude) echo "In a terminal on this machine type: claude auth login (inside Claude Code: /login). Sign in to the Claude account in the window that opens." ;;
  openai) echo "In a terminal on this machine type: codex login. Sign in to the ChatGPT (OpenAI) account in the window that opens." ;;
  gemini) echo "In a terminal on this machine type: gemini, then choose \"Login with Google\" and sign in in the window that opens." ;;
  esac; }
# Is the provider's own program on this machine logged in? (ready, waiting, or missing when the program is not here)
ai_window_state() {
  local cli; cli=$(ai_cli); as_ai_has "$cli" || { echo missing; return; }
  case "$AI" in
    claude) as_ai claude auth status >/dev/null 2>&1 && { echo ready; return; } ;;
    openai) as_ai codex login status >/dev/null 2>&1 && { echo ready; return; } ;;
    gemini) [ -s "$(ai_home)/.gemini/oauth_creds.json" ] && { echo ready; return; } ;;
  esac
  echo waiting
}
# Key format, as in the panel (Connectors): catches a key pasted for the wrong provider. Prints the problem, or nothing.
ai_key_problem() {
  local k="$1"
  case "$k" in *[!A-Za-z0-9._~+/=:-]*) echo "The key has characters a key never has (spaces or quotes?)."; return ;; esac
  [ "$AI" != claude ] && case "$k" in sk-ant-*) echo "This is a Claude key, but the chosen AI is $(ai_name)."; return ;; esac
  case "$AI" in
    claude) case "$k" in sk-ant-*) ;; *) echo "A Claude API key starts with sk-ant-." ;; esac ;;
    openai) case "$k" in sk-*) ;; *) echo "An OpenAI API key starts with sk-." ;; esac ;;
    grok)   case "$k" in xai-*) ;; *) echo "A Grok (xAI) API key starts with xai-." ;; esac ;;
  esac
}
# Test the connection: ask the provider for its list of models (nothing is sent to the model itself). The key goes in a
# header read from a 600 file (curl -H @file), never on the command line. Prints the HTTP code (000 = no answer).
ai_test() {
  local hf="" code="000" url base hdr=(); base=$(ai_base)
  if [ -s "$AI_PROVIDER_KEY" ]; then
    hf=$(mktemp); chmod 600 "$hf"; hdr=(-H "@$hf")
    if [ "$AI" = claude ]; then printf 'x-api-key: %s\nanthropic-version: 2023-06-01\n' "$(cat "$AI_PROVIDER_KEY")" > "$hf"
    else printf 'Authorization: Bearer %s\n' "$(cat "$AI_PROVIDER_KEY")" > "$hf"; fi
  fi
  local urls=("$base/models")
  # Another provider or a model on this machine: the address may come with or without /v1; Ollama also answers /api/tags.
  if [ "$AI" = other ]; then case "$base" in */v1) ;; *) urls=("$base/v1/models" "$base/models" "$base/api/tags") ;; esac; fi
  for url in "${urls[@]}"; do
    code=$(curl -s --max-time 15 -o /dev/null -w '%{http_code}' ${hdr[@]+"${hdr[@]}"} "$url" 2>/dev/null || true)
    [ "$code" = 200 ] && break
  done
  [ -z "$hf" ] || rm -f "$hf"
  echo "${code:-000}"
}
ai_json() {
  printf '{"provider":"%s","name":"%s","panel_slug":"%s","login":"%s","api_url":"%s","key_saved":%s,"ready":%s,"checked_at":"%s","recommended":"claude","installer":"%s"}\n' \
    "$AI" "$(json_s "$(ai_name)")" "$(ai_panel_slug)" "$AI_LOGIN" "$( [ "$AI" = other ] && json_s "$AI_URL" )" \
    "$( [ -s "$AI_PROVIDER_KEY" ] && echo true || echo false )" "$(is_done ai && echo true || echo false)" "$(date -u +%FT%TZ)" "$VERSION"
}
# Save the choice where the panel sees it: the installer's ai.json and, once Gildsite runs on this server, the instance's
# home folder (/app/.home/gildsite-ai.json inside the panel). The key is never part of it.
ai_share() {
  mkdir -p "$STATE_DIR"; ai_json > "$AI_CHOICE.tmp"; chmod 644 "$AI_CHOICE.tmp"; mv "$AI_CHOICE.tmp" "$AI_CHOICE"
  [ "$TARGET" != local ] && is_done run || return 0
  local dir uid own=(); dir=$(inst_dir); [ -d "$dir/dane/home" ] || return 0
  uid=$(grep '^UID_KLIENTA=' "$dir/.env" 2>/dev/null | cut -d= -f2 || true); [ -z "$uid" ] || own=(-o "$uid" -g "$uid")
  local put=(sudo_); [ "$(id -u)" = 0 ] || ! [ -w "$dir/dane/home" ] || { put=(); own=(); } # the instance folder is ours already
  if ${put[@]+"${put[@]}"} install -m 644 ${own[@]+"${own[@]}"} "$AI_CHOICE" "$dir/dane/home/gildsite-ai.json" 2>/dev/null; then ok "The panel sees the choice: $(ai_name)"
  else warn "Could not give the choice to the panel (folder $dir/dane/home); it is saved in $AI_CHOICE."; fi
}

cmd_ai() {
  load_answers
  [ -n "$AI" ] || die "No AI chosen yet." "Ask the person which AI Aurelius should use and save it: ./gildsite-install answer AI claude|openai|gemini|grok|other (Claude is recommended)."
  [ "$AI" != other ] || [ -n "$AI_URL" ] || die "No API address for $(ai_name) yet." "Ask for the provider's API address, or the address of the model on the person's machine, and save it: ./gildsite-install answer AI_URL <address>."
  say "Your AI: $(ai_name). Nothing on the server is changed; only the installer's own notes."
  if [ "$AI" = claude ]; then ok "Claude: recommended, Aurelius's engine is Claude Code."; else warn "$(ai_honest)"; fi
  if [ "$AI_LOGIN" = window ]; then
    case "$(ai_window_state)" in
      ready) ok "Logged in with the provider's window ($(ai_cli), account $(ai_user))" ;;
      missing) say "AI=WAITING"
               say "$(ai_cli) is not on this machine, so there is no login window yet. Two ways: use a key instead"
               say "(./gildsite-install answer AI_LOGIN key), or the person installs it first: $(ai_install_cli)"
               return 4 ;;
      *) say "AI=WAITING"; say "Ask the person: $(ai_window_how)"
         say "The login code or link stays in that terminal and the browser, never in the chat. Then run ./gildsite-install ai again."
         return 4 ;;
    esac
  else
    if [ ! -s "$AI_PROVIDER_KEY" ] && [ "$AI" != other ]; then
      say "AI=WAITING"
      say "Ask the person to make an API key at $(ai_where_key), then type it into the installer's secure field"
      say "themselves, in their own terminal on this machine: ./gildsite-install ai-key"
      say "The key is not shown while typing. Never ask for the key in the chat. Then run ./gildsite-install ai again."
      return 4
    fi
    local code; code=$(ai_test)
    case "$code" in
      200) ok "Connection test: $(ai_name) answers$( [ -s "$AI_PROVIDER_KEY" ] && echo ", the key works (key not shown)" )" ;;
      401|403) die "$(ai_name) refused the key (HTTP $code)." "Ask the person for a new key from $(ai_where_key) and to type it again with ./gildsite-install ai-key in their own terminal." ;;
      000) die "No answer from $(ai_base)." "Check the internet connection$( [ "$AI" = other ] && echo ", or that the model on that address is running" ), then run ./gildsite-install ai again." ;;
      *) die "$(ai_name) answered HTTP $code at $(ai_base)." "$( [ "$AI" = other ] && echo "Check the address (answer AI_URL) and the key, then run ./gildsite-install ai again." || echo "Try again in a minute; if it stays, make a new key." )" ;;
    esac
  fi
  mark_done ai; ai_share
  say ""; say "AI=READY. Aurelius will use $(ai_name). The person can change this later (answer AI ..., then ai)."
}

cmd_ai_key() { # the person runs this in their own terminal: hidden input, never shown, never in the chat
  load_answers
  [ -n "$AI" ] || die "No AI chosen yet." "Run ./gildsite-install answer AI claude|openai|gemini|grok|other first."
  [ "$AI_LOGIN" = key ] || die "The chosen login for $(ai_name) is the provider's own window, not a key." "To use a key instead: ./gildsite-install answer AI_LOGIN key, then ./gildsite-install ai-key again."
  local k=""
  if [ -t 0 ]; then printf 'Paste the %s API key and press Enter (it is not shown): ' "$(ai_name)" >&2; IFS= read -rs k || true; printf '\n' >&2
  else IFS= read -r k || true; fi
  k="${k//[$' \t\r\n']/}"
  [ -n "$k" ] || die "No key given." "Run ./gildsite-install ai-key in a terminal and paste the key when it asks."
  local p; p=$(ai_key_problem "$k")
  [ -z "$p" ] || { k=""; die "$p" "Make a key at $(ai_where_key) and run ./gildsite-install ai-key again."; }
  mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"
  ( umask 077; printf '%s' "$k" > "$AI_PROVIDER_KEY" ); chmod 600 "$AI_PROVIDER_KEY"; k=""
  rm -f "$DONE_DIR/ai"
  say "Key saved in the installer's secure file (not shown). Testing the connection…"
  cmd_ai
}

cmd_answer() {
  local key="${1:-}" val="${2:-}"
  case "$key" in
    TARGET) case "$val" in server|local) ;; *) die "TARGET must be server or local." "Use server for a server on the internet (as before), local for the person's own computer.";; esac
            if [ "$val" = server ]; then case "$(computer_kind)" in mac|windows) die "This is a personal computer ($(computer_name)), not a server." "Use: answer TARGET local. A server needs Linux (Ubuntu or Debian).";; esac; fi
            # First answer on a computer: keep the installer's files in ~/gildsite instead of /srv/gildsite.
            if [ "$val" = local ] && [ -n "$HOME_AUTO" ] && [ ! -f "$ANSWERS" ] && [ "$GILDSITE_HOME" = /srv/gildsite ]; then set_home "$HOME/gildsite"; fi ;;
    PUBLISH) case "$val" in server|cloudflare) ;; *) die "PUBLISH must be server or cloudflare." "Use: answer PUBLISH cloudflare (or server).";; esac
             load_answers; [ "$TARGET" = local ] || die "PUBLISH is only for an installation on a computer." "On a server the website is already public at its address; nothing to choose." ;;
    DOMAIN) echo "$val" | grep -Eq '^([a-z0-9-]+\.)+[a-z]{2,}$' || die "\"$val\" does not look like a website address." "Ask for an address like www.company.com (no https://, no slash)." ;;
    OWNER_EMAIL) echo "$val" | grep -Eq '^[^@ ]+@[^@ ]+\.[^@ ]+$' || die "\"$val\" does not look like an e-mail." "Ask for the owner's e-mail again." ;;
    COMPANY) [ -n "$val" ] || die "Company name is empty." "Ask for the company name." ;;
    DESIGN) case "$val" in on|off) ;; *) die "DESIGN must be on or off." "Use: answer DESIGN on";; esac ;;
    RELEASE) [ -n "$val" ] || die "RELEASE is empty." "Use a release tag like v1.2.0, or latest." ;;
    INSTANCE) echo "$val" | grep -Eq '^[a-z][a-z0-9-]{1,29}$' || die "INSTANCE must be 2-30 small letters, digits or dashes." "Use something like firma." ;;
    WEB_SERVER) case "$val" in caddy|existing) ;; *) die "WEB_SERVER must be caddy or existing." "Use existing when nginx or Apache already serves ports 80 and 443 on this server.";; esac ;;
    JOBS) echo "$val" | grep -Eq '^(none|(backup|knowledge|updates)(,(backup|knowledge|updates))*)$' || die "JOBS must be none or a list of backup, knowledge, updates." "Example: answer JOBS backup,knowledge (no night fixes)." ;;
    OWNER_LINK) case "$val" in yes|no) ;; *) die "OWNER_LINK must be yes or no." "Use no when the owner signs in with Google and needs no password link.";; esac ;;
    GITHUB_REPO) echo "$val" | grep -Eq '^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$' || die "\"$val\" is not a repository name." "Use owner/name, for example your-company/website." ;;
    AI) ai_known "$val" || die "AI must be claude, openai, gemini, grok or other." "Use: answer AI claude (recommended). other = any provider with an API key, or a model on the person's own machine."
        # Another provider: the key and the way of logging in chosen for the earlier one do not carry over.
        load_answers
        if [ "$val" != "$AI" ]; then rm -f "$AI_PROVIDER_KEY"; [ ! -f "$ANSWERS" ] || { grep -v "^AI_LOGIN=" "$ANSWERS" > "$ANSWERS.tmp" || true; chmod 600 "$ANSWERS.tmp"; mv "$ANSWERS.tmp" "$ANSWERS"; }; fi ;;
    AI_LOGIN) case "$val" in window|key) ;; *) die "AI_LOGIN must be window or key." "window = the provider's own login window; key = an API key typed into the installer's secure field (./gildsite-install ai-key).";; esac
              load_answers; if [ "$val" = window ] && ! ai_window_ok "$AI"; then die "$(ai_name) has no login window here." "Use: answer AI_LOGIN key"; fi ;;
    AI_URL) echo "$val" | grep -Eq '^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$' \
              || die "\"$val\" is not an API address." "Use the address only, with http:// or https://, no login, no ? or #. For example http://127.0.0.1:11434 (a model on this machine) or https://api.example.com/v1." ;;
    AI_NAME) echo "$val" | grep -Eq '^[A-Za-z0-9 ._()-]{1,40}$' || die "AI_NAME must be 1-40 letters, digits, spaces or . _ ( ) -." "For example: answer AI_NAME \"Mistral\"." ;;
    *) die "Unknown answer \"$key\"." "Use one of: TARGET, PUBLISH, DOMAIN, OWNER_EMAIL, COMPANY, AI, AI_LOGIN, AI_URL, AI_NAME, DESIGN, RELEASE, INSTANCE, WEB_SERVER, JOBS, OWNER_LINK, GITHUB_REPO." ;;
  esac
  # A new AI choice (or a new way to log in) has to be tested again.
  case "$key" in AI|AI_LOGIN|AI_URL) rm -f "$DONE_DIR/ai" ;; esac
  mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"; touch "$ANSWERS"; chmod 600 "$ANSWERS"
  grep -v "^$key=" "$ANSWERS" > "$ANSWERS.tmp" || true
  printf '%s=%q\n' "$key" "$val" >> "$ANSWERS.tmp"; chmod 600 "$ANSWERS.tmp"; mv "$ANSWERS.tmp" "$ANSWERS"
  # A new answer after consent changes the plan, so the person has to agree again. PUBLISH is chosen after the first page
  # (and can change later in the chat with Aurelius); publishing itself asks for its own yes. The AI (AI, AI_*) can change
  # any time too: it changes nothing on the server, only who Aurelius talks to.
  case "$key" in AI|AI_*) say "Saved $key."; return 0 ;; esac
  [ "$key" != GITHUB_REPO ] && [ "$key" != PUBLISH ] && [ -f "$CONSENT" ] && rm -f "$CONSENT" && say "The plan changed, so the earlier yes no longer counts. Show the plan again."
  say "Saved $key."
}

plan_local() {
  local missing=()
  [ -n "$OWNER_EMAIL" ] || missing+=(OWNER_EMAIL); [ -n "$COMPANY" ] || missing+=(COMPANY)
  [ ${#missing[@]} -eq 0 ] || die "Missing answers: ${missing[*]}." "Ask the person and save each with ./gildsite-install answer KEY VALUE."
  cat <<LOCALPLAN
PLAN (nothing has been changed yet)

Where:    this computer ($(computer_name))
Panel:    on this computer, in Docker (the address is shown at the end, like http://127.0.0.1:4450/admin)
Website:  only a preview on this computer, until the person chooses where to publish it
Address:  ${DOMAIN:-not chosen yet (needed only when publishing)}
Owner:    $OWNER_EMAIL
Company:  $COMPANY$( [ -n "$AI" ] && printf '\nYour AI:  %s' "$(ai_plan_line)" )

What will happen on this computer:
  1. Check that Docker runs. The installer does not install Docker on a computer; the person does it with the guide
     (./gildsite-install docker-help).
  2. Keep the installer's files in the folder $GILDSITE_HOME.
  3. $( [ -n "${GILDSITE_SOURCE:-}" ] && echo "Take the Gildsite code from the local copy ${GILDSITE_SOURCE}." || echo "Download Gildsite release \"$RELEASE\" from GitHub." )
  4. Start in Docker: panel, database, search, Aurelius engine, and the website as a preview.
  5. Create the owner account for $OWNER_EMAIL.
  Installer $VERSION does part 1 and stops there: parts 2 to 5 on a computer come with the next installer version.

What will NOT happen:
  - Nothing goes on the internet: no DNS, no ports open to other computers (everything listens on 127.0.0.1 only).
  - No other programs on this computer are changed or stopped.
  - No passwords or keys are shown in the chat; they are stored in files only this account can read.

Later, after the first page: where to publish the website (answer PUBLISH server or cloudflare${PUBLISH:+, now: $PUBLISH}).
The person can change that choice later in the chat with Aurelius.
LOCALPLAN
}

cmd_plan() {
  load_answers
  [ "$TARGET" = local ] && { plan_local; return; }
  local missing=()
  [ -n "$DOMAIN" ] || missing+=(DOMAIN); [ -n "$OWNER_EMAIL" ] || missing+=(OWNER_EMAIL); [ -n "$COMPANY" ] || missing+=(COMPANY)
  [ ${#missing[@]} -eq 0 ] || die "Missing answers: ${missing[*]}." "Ask the person and save each with ./gildsite-install answer KEY VALUE."
  cat <<PLAN
PLAN (nothing has been changed yet)

Website:  https://$DOMAIN
Panel:    https://$DOMAIN/admin
Owner:    $OWNER_EMAIL
Company:  $COMPANY$( [ -n "$AI" ] && printf '\nYour AI:  %s' "$(ai_plan_line)" )

What will happen on this server:
  1. Install Docker (if missing) and create the folder $GILDSITE_HOME.
  2. $( [ -n "${GILDSITE_SOURCE:-}" ] && echo "Take the Gildsite code from the local copy ${GILDSITE_SOURCE}." || echo "Download Gildsite release \"$RELEASE\" from GitHub." )
  3. Start in Docker: website, panel, database, search, Aurelius engine$( [ "$DESIGN" = on ] && echo ", Design" ).
$( if [ "$WEB_SERVER" = existing ]; then echo "  4. Keep the web server already running here (nginx or Apache): the installer writes a ready config file
     for it and does not change it. Whoever looks after that server adds the file and the HTTPS certificate."; echo "  5. The panel and website listen only inside the server; the existing web server passes visitors to them."; else echo "  4. Start the web server (Caddy) with an HTTPS certificate for the address."; echo "  5. Open only ports 80 and 443 for the website. The database and panel internals stay inside the server."; echo "     (An existing firewall is not changed.)"; fi )
  6. Updates from the panel: a dot and "Update now" when a new version is out (always on).
     Scheduled jobs (the person chooses, now: ${JOBS}):
       backup    = nightly backup of the database and photos at 3:30, kept 7 days
       knowledge = Knowledge wiki refreshed every 15 minutes
       updates   = small fixes install by themselves at night (4:30; off by default for now)
  7. Create the owner account for $OWNER_EMAIL$( [ "$OWNER_LINK" = yes ] && echo " and give a one-time link to set the password" || echo " (sign-in without a password link, e.g. Google)" ).

What will NOT happen:
  - No other programs or websites on this server are changed or stopped.
  - No passwords or keys are shown in the chat; they are stored in files only root can read.

Optional after install (asked separately): connect Aurelius to the AI on this server, connect GitHub.
PLAN
}

cmd_consent() {
  [ "${1:-}" = yes ] || die "Consent must be given as: consent yes" "Only run this after the person clearly said yes to the plan."
  cmd_plan >/dev/null
  mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"
  { date -u +%FT%TZ; { sha256sum "$ANSWERS" 2>/dev/null || shasum -a 256 "$ANSWERS"; } | cut -d" " -f1; } > "$CONSENT"
  load_answers
  if [ "$TARGET" = local ]; then say "Consent recorded. Next: ./gildsite-install run"; else say "Consent recorded. Next: ./gildsite-install dns"; fi
}

cmd_dns() {
  load_answers
  if [ "$TARGET" = local ]; then
    say "Nothing to add: on a computer the website is only a preview, so no DNS record is needed now."
    say "The address matters when publishing (answer PUBLISH). Next: ./gildsite-install run"
    return 0
  fi
  [ -n "$DOMAIN" ] || die "No website address yet." "Run ./gildsite-install answer DOMAIN <address> first."
  local ip; ip=$(public_ip)
  [ -n "$ip" ] || die "Could not find this server's public address." "Ask the person for the server's IP address (it is in their hosting panel)."
  local bare=""; case "$DOMAIN" in www.*) bare="${DOMAIN#www.}";; esac
  say "Add at the domain provider (DNS settings):"
  say "  Type A   Name: $DOMAIN   Value: $ip"
  [ -n "$bare" ] && say "  Type A   Name: $bare   Value: $ip   (optional: the address without www then opens the site too)"
  say ""
  local got; got=$(resolve "$DOMAIN")
  if [ "$got" = "$ip" ]; then ok "$DOMAIN points to this server"; else warn "$DOMAIN ${got:+points to $got}${got:-is not set yet}"; fi
  if [ -n "$bare" ]; then local g2; g2=$(resolve "$bare"); [ "$g2" = "$ip" ] && ok "$bare points to this server" || warn "$bare not pointing here (optional)"; fi
  if [ "$got" = "$ip" ]; then mark_done dns; say "DNS READY. Next: ./gildsite-install run"; else say "Waiting for DNS. New records usually work within 5–30 minutes. Run this again in a minute or two."; return 4; fi
}

# ---------- install (step "run") ----------
# The site itself comes from the private repo webdev-wzornik. Its own script skrypty/nowy-klient.sh creates the instance
# in /srv/klienci/<name>; this installer prepares the source, then switches the instance from test mode to production
# and puts the Caddy web server in front. Every part is skipped when already done, so `run` can be repeated safely.
SOURCE_REPO="${GILDSITE_SOURCE_REPO:-marcink-ui/webdev-wzornik}"
SOURCE_DIR="$GILDSITE_HOME/zrodlo"
WWW_DIR="$GILDSITE_HOME/www"
KEY_FILE="$STATE_DIR/download-key"
LOG="$STATE_DIR/install.log"

instance_name() { local n="${INSTANCE:-}"; [ -n "$n" ] || n=$(echo "${DOMAIN#www.}" | cut -d. -f1 | tr -c 'a-z0-9-\n' '-' | sed 's/^[^a-z]*//' | cut -c1-30); [ ${#n} -ge 2 ] || n="gildsite"; echo "$n"; }
inst_dir() { echo "${GILDSITE_CLIENTS_DIR:-/srv/klienci}/$(instance_name)"; }
sudo_() { if [ "$(id -u)" = 0 ]; then "$@"; else sudo "$@"; fi; }
step() { printf '\n== %s\n' "$*"; printf '\n== %s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$LOG"
  case "$*" in [1-7]/7*) RUN_STEP=${1%%/*}; progress_set running "$RUN_STEP" "$*";; esac; activity step "Working on: ${*#[1-7]/7 }"; }
logrun() { "$@" >> "$LOG" 2>&1; }
# Proxy settings of the server (if any) are passed to build and install containers.
proxy_args() { local v; for v in HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy; do [ -n "${!v:-}" ] && printf -- '--build-arg %s=%s ' "$v" "${!v}"; done; true; }
proxy_env()  { local v; for v in HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy; do [ -n "${!v:-}" ] && printf -- '-e %s=%s ' "$v" "${!v}"; done; [ -n "${GILDSITE_EXTRA_CA:-}" ] && printf -- '-v %s:/extra-ca.crt:ro -e NODE_EXTRA_CA_CERTS=/extra-ca.crt ' "$GILDSITE_EXTRA_CA"; true; }
setenv() { # setenv FILE KEY VALUE: replace or add one line in a .env file
  local f="$1" k="$2" v="$3"; grep -v "^$k=" "$f" > "$f.tmp" || true; printf '%s=%s\n' "$k" "$v" >> "$f.tmp"; cat "$f.tmp" > "$f"; rm -f "$f.tmp"; }
dropenv() { local f="$1"; shift; local k; for k in "$@"; do grep -v "^$k=" "$f" > "$f.tmp" || true; cat "$f.tmp" > "$f"; rm -f "$f.tmp"; done; }

run_docker() {
  step "1/7 Docker"
  if have docker && docker info >/dev/null 2>&1; then ok "Docker is running"; return; fi
  have docker || { say "Installing Docker (official script from get.docker.com)…"; curl -fsSL https://get.docker.com | sudo_ sh >> "$LOG" 2>&1 || die "Docker could not be installed." "Show the person the last lines of $LOG."; }
  sudo_ systemctl enable --now docker >> "$LOG" 2>&1 || true
  docker info >/dev/null 2>&1 || die "Docker is installed but not running." "Restart the server once, then run ./gildsite-install run again."
  ok "Docker installed"
}
# The update script compares screenshots before and after with Python + Pillow on the server itself.
run_pillow() {
  python3 -c 'import PIL' 2>/dev/null && return 0
  have apt-get && sudo_ apt-get install -y python3-pil >> "$LOG" 2>&1 && ok "Python image library installed (used to check updates)" \
    || warn "Python image library (python3-pil) missing: updates still work, but the before/after screenshot check reports an error."
}

run_source() {
  step "2/7 Gildsite code ($RELEASE)"
  if [ -n "${GILDSITE_SOURCE:-}" ]; then # local copy (tests, or a server without GitHub access)
    if [ ! -d "$SOURCE_DIR/.git" ]; then
      mkdir -p "$GILDSITE_HOME"; local src="$GILDSITE_SOURCE"
      # A folder owned by another user makes git refuse ("dubious ownership"), so a folder goes through a bundle file.
      if [ -d "$src" ]; then src="$STATE_DIR/source.bundle"; logrun git -c safe.directory='*' -C "$GILDSITE_SOURCE" bundle create "$src" --all || die "Reading the local copy $GILDSITE_SOURCE failed." "Check $LOG."; fi
      logrun git clone -q "$src" "$SOURCE_DIR" || die "Copying the code from $GILDSITE_SOURCE failed." "Check $LOG."
      rm -f "$STATE_DIR/source.bundle"
    fi
    pick_release "$RELEASE"; ok "Code from local copy $GILDSITE_SOURCE ($(release_name))"; return
  fi
  local url="https://github.com/$SOURCE_REPO.git" ref="$RELEASE"
  if [ ! -d "$SOURCE_DIR/.git" ]; then
    mkdir -p "$GILDSITE_HOME"
    if have gh && gh auth status >/dev/null 2>&1 && gh repo view "$SOURCE_REPO" >/dev/null 2>&1; then
      logrun gh repo clone "$SOURCE_REPO" "$SOURCE_DIR" || die "Download from GitHub failed." "Check $LOG; then run again."
    elif [ -s "$KEY_FILE" ]; then
      logrun git -c "http.extraHeader=$(key_header)" clone "$url" "$SOURCE_DIR" \
        || die "Download from GitHub failed: the download key is wrong or expired." "Ask the person for a new download key and save it with ./gildsite-install key."
    else
      die "No access to the Gildsite code yet." "Ask the person for the download key they got with Gildsite, then save it with ./gildsite-install key (it reads the key from input, never print it)." 5
    fi
  fi
  if [ -s "$KEY_FILE" ]; then logrun git -c "http.extraHeader=$(key_header)" -C "$SOURCE_DIR" fetch --tags -q || true
  else logrun git -C "$SOURCE_DIR" fetch --tags -q || true; fi
  pick_release "$ref"
  ok "Code ready ($(release_name))"
}
key_header() { printf 'Authorization: Basic %s' "$(printf 'x-access-token:%s' "$(cat "$KEY_FILE")" | base64 -w0)"; }
# "latest" = the newest release tag (vX.Y.Z), not whatever the default branch holds; without tags the newest code stays.
pick_release() {
  local ref="$1"
  if [ "$ref" = latest ]; then
    ref=$(git -C "$SOURCE_DIR" tag -l 'v*' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1 || true)
    [ -n "$ref" ] || { warn "No Gildsite release found; using the newest code. Updates from the panel start with the first release."; return 0; }
  fi
  logrun git -C "$SOURCE_DIR" -c advice.detachedHead=false checkout -q "$ref" || die "Release $ref not found." "Use ./gildsite-install answer RELEASE latest, or a release that exists."
}
release_name() { git -C "$SOURCE_DIR" describe --tags --exact-match 2>/dev/null || git -C "$SOURCE_DIR" log -1 --format='code %h'; }

run_deps() {
  step "3/7 Libraries (a few minutes)"
  # shellcheck disable=SC2046
  if docker image inspect klient-node:22 >/dev/null 2>&1; then ok "Base image already there"; else
    logrun docker build --network host $(proxy_args) -t klient-node:22 "$SOURCE_DIR/obraz" || die "Building the base image failed." "Check internet access from the server and $LOG."
    ok "Base image built"; fi
  local d
  for d in app astro wektory; do
    [ -f "$SOURCE_DIR/$d/package-lock.json" ] || continue
    if [ -d "$SOURCE_DIR/$d/node_modules" ] && [ -f "$SOURCE_DIR/$d/node_modules/.package-lock.json" ]; then ok "$d: already installed"; continue; fi
    # shellcheck disable=SC2046
    logrun docker run --rm --network host $(proxy_env) -v "$SOURCE_DIR/$d:/w" -w /w klient-node:22 npm ci --no-audit --no-fund --loglevel=error \
      || die "Installing libraries for $d failed." "Check internet access from the server and $LOG."
    ok "$d: installed"
  done
}

run_instance() {
  local name dir; name=$(instance_name); dir=$(inst_dir)
  step "4/7 Website and panel ($name), first build (10–20 minutes)"
  if [ -f "$dir/.env" ] && docker ps --format '{{.Names}}' | grep -q "^$name-panel$"; then models_owner "$dir"; ok "Instance $name already exists"; return; fi
  [ -e "$dir" ] && die "Folder $dir exists but the instance is not running." "Do not delete it. Tell Marcin; the folder may hold someone's data."
  sudo_ mkdir -p "$(dirname "$dir")"
  if ! MIN_GB="${MIN_GB:-15}" logrun sh "$SOURCE_DIR/skrypty/nowy-klient.sh" "$name"; then
    # The last parts of nowy-klient (Knowledge wiki, its timer) are extras: if panel and website run, we go on.
    if [ -f "$dir/.env" ] && docker ps --format '{{.Names}}' | grep -q "^$name-panel$" && docker ps --format '{{.Names}}' | grep -q "^$name-strona$"; then
      models_owner "$dir"; warn "Instance $name runs, but an extra (Knowledge wiki or its timer) did not finish. It retries later; see $LOG."
      return
    fi
    die "Creating the instance failed." "Show the person the last lines of $LOG (no passwords are in it)."
  fi
  models_owner "$dir"
  ok "Instance $name created"
}
# Search needs dane/modele owned by the instance user; when Docker creates it, it belongs to root and search keeps restarting.
models_owner() { local d="$1" u; u=$(grep '^UID_KLIENTA=' "$d/.env" | cut -d= -f2); [ -n "$u" ] || return 0
  sudo_ mkdir -p "$d/dane/modele"; [ "$(stat -c %u "$d/dane/modele")" = "$u" ] && return 0
  sudo_ chown -R "$u:$u" "$d/dane/modele"; ( cd "$d" && docker compose restart wektory >> "$LOG" 2>&1 ) || true; ok "Search model folder fixed (owner $u)"; }

run_production() {
  local name dir e sub; name=$(instance_name); dir=$(inst_dir); e="$dir/.env"
  step "5/7 Production settings and owner account"
  if is_done production; then ok "Already in production mode"; return; fi
  cp -p "$e" "$e.przed-instalator-$(date -u +%Y%m%d%H%M%S)"
  sub=$(grep '^PODSIEC=' "$e" | cut -d= -f2 | sed 's#\.0/24##')
  # Test mode off: no fake Google, no sandbox profile (Google sign-in is set up later in Connectors).
  # PORT_GOOGLE stays: the fake Google service is off, but docker compose warns on every command when the value is missing.
  dropenv "$e" TRYB COMPOSE_PROFILES GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET GOOGLE_AUTH_URL GOOGLE_TOKEN_URL GOOGLE_USERINFO_URL GOOGLE_DOMENY
  setenv "$e" DOMENA "${DOMAIN#www.}"
  setenv "$e" FIRMA "\"$COMPANY\""
  setenv "$e" ADRES_PUBLICZNY "https://$DOMAIN"
  # Only the web server in front is trusted for the visitor's IP: Caddy from a fixed address in the instance network,
  # an existing nginx/Apache through the Docker gateway (.1) of that network.
  if [ "$WEB_SERVER" = existing ]; then setenv "$e" ZAUFANE_PROXY "$sub.1"; else setenv "$e" ZAUFANE_PROXY "$sub.250"; fi
  docker rm -f "$name-google-atrapa" >/dev/null 2>&1 || true
  # Owner account: the e-mail the person gave; other demo accounts stay locked with random passwords.
  install -m 644 "$INSTALLER_DIR/templates/wlasciciel.ts" "$dir/app/tools/gildsite-install-wlasciciel.ts"
  ( cd "$dir" && OWNER_EMAIL="$OWNER_EMAIL" COMPANY="$COMPANY" logrun docker compose --profile narzedzia run --rm -T -e OWNER_EMAIL -e COMPANY narzedzia npx payload run tools/gildsite-install-wlasciciel.ts ) \
    || die "Setting the owner e-mail failed." "Check $LOG."
  ( cd "$dir" && MIN_GB="${MIN_GB:-15}" logrun sh skrypty/buduj.sh oba ) || die "Build with production settings failed." "Check $LOG; the earlier version keeps running."
  ( cd "$dir" && logrun sh skrypty/start.sh ) || true
  mark_done production; ok "Production mode on, owner: $OWNER_EMAIL"
}

run_www() {
  local name dir sub; name=$(instance_name); dir=$(inst_dir)
  sub=$(grep '^PODSIEC=' "$dir/.env" | cut -d= -f2 | sed 's#\.0/24##')
  local alias=""; case "$DOMAIN" in www.*) alias="${DOMAIN#www.}";; esac
  if [ "$WEB_SERVER" = existing ]; then
    step "6/7 Config for the existing web server (not changed by the installer)"
    local pp ps f="$GILDSITE_HOME/nginx-$name.conf"
    pp=$(grep '^PORT_PANEL=' "$dir/.env" | cut -d= -f2); ps=$(grep '^PORT_STRONA=' "$dir/.env" | cut -d= -f2)
    sed -e "s#__DOMAIN__#$DOMAIN#g" -e "s#__ALIAS__#${alias}#g" -e "s#__PORT_PANEL__#$pp#g" -e "s#__PORT_STRONA__#$ps#g" \
      "$INSTALLER_DIR/templates/nginx-site.conf.template" > "$f"; chmod 644 "$f"
    ok "nginx config written: $f"
    warn "Whoever looks after this server copies it to /etc/nginx/sites-available/, runs nginx -t, reloads nginx and adds HTTPS (certbot --nginx -d $DOMAIN${alias:+ -d $alias})."
    return
  fi
  step "6/7 Web server with HTTPS (Caddy)"
  mkdir -p "$WWW_DIR"
  sed -e "s#__DOMAIN__#$DOMAIN#g" -e "s#__ALIAS__#${alias:-__none__}#g" -e "s#__EMAIL__#$OWNER_EMAIL#g" \
      -e "s#__TLS__#${GILDSITE_TLS:+tls $GILDSITE_TLS}#g" "$INSTALLER_DIR/templates/Caddyfile.template" > "$WWW_DIR/Caddyfile"
  [ -n "$alias" ] || sed -i '/__none__/,/^}/d' "$WWW_DIR/Caddyfile"
  sed -e "s#__NAME__#$name#g" -e "s#__IP__#$sub.250#g" "$INSTALLER_DIR/templates/www-compose.yml" > "$WWW_DIR/docker-compose.yml"
  chmod 644 "$WWW_DIR/Caddyfile" "$WWW_DIR/docker-compose.yml"
  ( cd "$WWW_DIR" && logrun docker compose up -d ) || die "The web server did not start." "Ports 80 or 443 may be taken by another program (then: ./gildsite-install answer WEB_SERVER existing); check $LOG."
  ok "Caddy running for $DOMAIN${alias:+ (and $alias redirects to it)}"
}

run_backup() {
  local name dir; name=$(instance_name); dir=$(inst_dir)
  step "7/7 Nightly backup and updates"
  if ! job_on backup; then
    ok "Nightly backup: not turned on (the person chose so). Turn on later: ./gildsite-install answer JOBS ... and run again."
  elif have systemctl && [ -d /run/systemd/system ]; then
    sudo_ tee /etc/systemd/system/gildsite-kopia-$name.service >/dev/null <<UNIT
[Unit]
Description=Gildsite nightly backup ($name)
[Service]
Type=oneshot
ExecStart=/bin/sh $dir/skrypty/kopia-nocna.sh
UNIT
    sudo_ tee /etc/systemd/system/gildsite-kopia-$name.timer >/dev/null <<UNIT
[Unit]
Description=Gildsite nightly backup ($name) at 3:30
[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true
[Install]
WantedBy=timers.target
UNIT
    sudo_ systemctl daemon-reload && sudo_ systemctl enable --now "gildsite-kopia-$name.timer" >> "$LOG" 2>&1 && ok "Backup every night at 3:30 (7 days kept)"
  else
    warn "No systemd here: nightly backup not scheduled. Run $dir/skrypty/kopia-nocna.sh by hand or from cron."
  fi
  run_updates
  jobs_apply
}
job_on() { case ",$JOBS," in *",$1,"*) return 0;; *) return 1;; esac; }
# Timers made by other scripts (Knowledge wiki by nowy-klient.sh, night fixes by aktualizacje-instaluj.sh) follow the person's choice.
jobs_apply() {
  have systemctl && [ -d /run/systemd/system ] || return 0
  local name; name=$(instance_name)
  if ! job_on knowledge && systemctl list-unit-files "gildsite-wiedza-$name.timer" >/dev/null 2>&1; then
    sudo_ systemctl disable --now "gildsite-wiedza-$name.timer" >> "$LOG" 2>&1 && ok "Knowledge refresh every 15 min: off (the person chose so)"
  fi
  if ! job_on updates && systemctl list-unit-files "gildsite-aktualizacje-noc-$name.timer" >/dev/null 2>&1; then
    sudo_ systemctl disable --now "gildsite-aktualizacje-noc-$name.timer" >> "$LOG" 2>&1 && ok "Night fixes: off; new versions only through Update now"
  fi
}

# Updates from the panel (Gildsite 1.3.0+): the panel shows a dot and "Update now" when gildsite.com lists a newer release;
# small fixes install by themselves at night. The instance fetches new releases from GitHub with the same read-only
# download key, kept only in this instance's own git settings (root only), never in the panel.
run_updates() {
  local dir; dir=$(inst_dir)
  [ -f "$dir/skrypty/aktualizacje-wykonawca.sh" ] || { warn "This release has no updates from the panel yet (needs Gildsite 1.3.0 or newer)."; return 0; }
  # The instance belongs to its own user; root runs the updates, so git has to trust this one folder.
  git config --global --get-all safe.directory 2>/dev/null | grep -qxF "$dir" || git config --global --add safe.directory "$dir"
  git -C "$dir" remote get-url wzornik >/dev/null 2>&1 || logrun git -C "$dir" remote add wzornik "https://github.com/$SOURCE_REPO.git"
  if [ -s "$KEY_FILE" ]; then
    git -C "$dir" config "http.https://github.com/.extraHeader" "$(key_header)"; chmod 600 "$dir/.git/config"
  elif have gh && gh auth status >/dev/null 2>&1; then
    logrun gh auth setup-git || true
  else
    warn "No download key saved: the panel will see new versions but cannot download them. Save the key with ./gildsite-install key and run again."
  fi
  if have systemctl && [ -d /run/systemd/system ]; then
    ( cd "$dir" && sudo_ sh skrypty/aktualizacje-instaluj.sh >> "$LOG" 2>&1 ) && updates_home && ok "Update now in the panel is on" \
      || warn "Turning on updates from the panel failed; see $LOG. The site works; updates can be turned on later."
  else
    warn "No systemd here: Update now in the panel cannot run. Updates can still be run by hand: sh $dir/skrypty/aktualizacje-wykonawca.sh --noc"
  fi
  ( cd "$dir" && sh skrypty/aktualizacje-wykonawca.sh --stan >> "$LOG" 2>&1 ) || true
  local v; v=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("wersja") or "")' "$dir/dane/home/aktualizacje/stan.json" 2>/dev/null || true)
  if [ -n "$v" ]; then ok "Installed version: $v"; else warn "The installed code has no release number yet; Update now works from the next release."; fi
}

# The update services run as root without HOME in releases before 1.4.0; git then does not see the trusted folder and stops.
updates_home() {
  local name u; name=$(instance_name)
  for u in "gildsite-aktualizacje-$name.service" "gildsite-aktualizacje-noc-$name.service"; do
    [ -f "/etc/systemd/system/$u" ] || continue
    grep -q '^Environment=.*HOME=' "/etc/systemd/system/$u" && continue
    sudo_ mkdir -p "/etc/systemd/system/$u.d"
    printf '[Service]\nEnvironment=HOME=/root\n' | sudo_ tee "/etc/systemd/system/$u.d/gildsite-install-home.conf" >/dev/null
  done
  sudo_ systemctl daemon-reload
}

# On a computer: Docker is checked, never installed (the person installs Docker Desktop with the guide).
run_local() {
  [ -n "$OWNER_EMAIL" ] && [ -n "$COMPANY" ] || die "Answers are missing." "Run ./gildsite-install plan."
  mkdir -p "$STATE_DIR"; touch "$LOG"; chmod 600 "$LOG"
  say "Gildsite on this computer. Details go to $LOG. Progress card: ./gildsite-install progress"
  ACTIVITY_ON=1; progress_set running 1 "starting"
  step "1/7 Docker on this computer"
  case "$(docker_state)" in
    running) ;;
    missing) die "Docker is not installed on this computer." "Run ./gildsite-install docker-help and guide the person step by step, then run again." ;;
    no-access) die "Docker is installed, but this account may not use it." "Run ./gildsite-install docker-help (part \"no access\"), then run again." ;;
    *) die "Docker is installed but not running." "Ask the person to start Docker Desktop (or Docker), wait a minute, then run again." ;;
  esac
  local m; m=$(docker_mem_gb)
  [ -z "$m" ] || [ "$m" -ge "$MIN_RAM_GB" ] || die "Docker may use only $m GB of memory, needs $MIN_RAM_GB GB." "Docker Desktop: Settings, Resources, Memory at least $MIN_RAM_GB GB, Apply & restart; then run again."
  ok "Docker is running${m:+ ($m GB of memory for Docker)}"
  mark_done docker
  # The template's own script (nowy-klient.sh) still creates instances only in /srv/klienci on a Linux server.
  die "Installer $VERSION checks the computer and Docker; installing Gildsite on a computer comes with the next installer version." \
      "Tell the person the computer is ready and the answers are saved; nothing else was changed. Run ./gildsite-install run again with the next installer version." 3
}

cmd_run() {
  need_consent; load_answers
  # shellcheck disable=SC2317 # run_local stops on its own (die) in this version; return keeps the server path below untouched
  [ "$TARGET" = local ] && { run_local; return; }
  [ -n "$DOMAIN" ] && [ -n "$OWNER_EMAIL" ] && [ -n "$COMPANY" ] || die "Answers are missing." "Run ./gildsite-install plan."
  is_done dns || [ -n "${GILDSITE_SKIP_DNS:-}" ] || die "The website address does not point to this server yet." "Run ./gildsite-install dns and wait until it says DNS READY."
  mkdir -p "$STATE_DIR"; touch "$LOG"; chmod 600 "$LOG"
  say "Installing Gildsite. Details go to $LOG. Progress card: ./gildsite-install progress"
  ACTIVITY_ON=1; progress_set running 1 "starting"
  run_docker; run_pillow; run_source; run_deps; run_instance; run_production; run_www; run_backup
  mark_done run; progress_set done 8 "installed"; activity ok "Gildsite installed"
  if [ -n "$AI" ]; then ai_share; fi # the panel sees the AI chosen before the install
  say ""; say "INSTALLED. Next: ./gildsite-install finish"
}

cmd_key() {
  need_consent
  mkdir -p "$STATE_DIR"; local k; IFS= read -r k || true
  [ -n "$k" ] || die "No key given." "Pipe the key in: printf '%s' '<key>' | ./gildsite-install key"
  printf '%s' "$k" > "$KEY_FILE"; chmod 600 "$KEY_FILE"; say "Download key saved (not shown)."
}

cmd_finish() {
  need_consent; load_answers; ACTIVITY_ON=1
  is_done run || die "Gildsite is not installed yet." "Run ./gildsite-install run first."
  local name dir pd site panel; name=$(instance_name); dir=$(inst_dir); pd="$DOMAIN"
  local ip="${GILDSITE_TEST_IP:-127.0.0.1}" k="${GILDSITE_TLS:+-k}"
  site=$(curl -s --noproxy '*' $k -o /dev/null -w '%{http_code}' --resolve "$DOMAIN:443:$ip" "https://$DOMAIN/" || true)
  panel=$(curl -s --noproxy '*' $k -o /dev/null -w '%{http_code}' --resolve "$DOMAIN:443:$ip" "https://$DOMAIN/admin/login" || true)
  [ "$site" = 200 ] && ok "Website answers (https://$DOMAIN)" || bad "Website: HTTP $site"
  [ "$panel" = 200 ] && ok "Panel answers (https://$DOMAIN/admin)" || bad "Panel: HTTP $panel"
  { [ "$site" = 200 ] && [ "$panel" = 200 ]; } || die "Not everything answers yet." "Wait a minute and run ./gildsite-install finish again; if it stays, check $LOG."
  if [ "$OWNER_LINK" = no ]; then
    mark_done finish
    say ""; say "DONE. The owner signs in at https://$pd/admin with $OWNER_EMAIL (no password link was made, as chosen)."
    say "New versions: the panel shows a dot in the menu and the owner clicks Update now."
    return
  fi
  # One-time link: the owner sets their own password (no password ever goes through the chat).
  local token
  token=$(cd "$dir" && docker compose --profile narzedzia run --rm -T -e OWNER_EMAIL="$OWNER_EMAIL" -e TYLKO_LINK=1 narzedzia npx payload run tools/gildsite-install-wlasciciel.ts 2>/dev/null | sed -n 's/^LINK-TOKEN=//p' | tail -1)
  [ -n "$token" ] || die "Could not create the login link." "Check $LOG."
  mark_done finish
  say ""; say "DONE. Give the person this one-time link (valid 1 hour) to set their password:"
  say "  https://$pd/admin/reset/$token"
  say "After that they log in at https://$pd/admin and the panel guides them (Setup)."
  say "New versions: the panel shows a dot in the menu and the owner clicks Update now$(job_on updates && echo "; small fixes install by themselves at night")."
}

# ---------- connections (steps "aurelius" and "github") ----------
# Both use the template's server command app/tools/serwer-polaczenia.ts (release 9cbf11d or newer). It writes the AI Access
# password only to a file (600) and logs every change in Security Log. Secrets never go through the chat or the command line
# of the panel: files in the instance folder dane/home (= /app/.home in the container), removed right after use.
AI_KEY_FILE="$STATE_DIR/ai-access-key"
GH_DIR="$STATE_DIR/gh"
GH_OUT="$STATE_DIR/github-login.out"
GH_PID="$STATE_DIR/github-login.pid"

need_tool() { [ -f "$(inst_dir)/app/tools/serwer-polaczenia.ts" ] || die "This Gildsite release cannot set up connections from the server yet." "Install a newer release (./gildsite-install answer RELEASE <tag>, then run), or set it up in the panel: Settings." 3; }
inst_uid() { grep '^UID_KLIENTA=' "$(inst_dir)/.env" | cut -d= -f2; }
connections() { # connections ENV...: run the server command in the tools container, output to the log and stdout (no secrets in it)
  local dir; dir=$(inst_dir)
  ( cd "$dir" && docker compose --profile narzedzia run --rm -T "$@" narzedzia npx payload run tools/serwer-polaczenia.ts 2>>"$LOG" | tee -a "$LOG" | grep -E '^(AI-ACCESS-ID|GITHUB)=|missing|must|There is no|does not exist' )
}
# The AI client belongs to the person who runs the AI (with sudo: that user, not root).
ai_user() { if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then echo "$SUDO_USER"; else id -un; fi; }
ai_home() { [ -n "${GILDSITE_AI_HOME:-}" ] && { echo "$GILDSITE_AI_HOME"; return; }; getent passwd "$(ai_user)" | cut -d: -f6; }
ai_path() { local h; h=$(ai_home); echo "$h/.local/bin:$h/.claude/local:$h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin:$PATH"; }
as_ai() { local u p; u=$(ai_user); p=$(ai_path); if [ "$u" = "$(id -un)" ]; then HOME="$(ai_home)" PATH="$p" "$@"; else sudo -u "$u" -H env PATH="$p" "$@"; fi; }
as_ai_has() { as_ai sh -c "command -v $1" >/dev/null 2>&1; }

mcp_check() { # does the panel answer AI Access with this key? (header from a 600 file, never on the command line)
  local hf code ip="${GILDSITE_TEST_IP:-127.0.0.1}"; hf=$(mktemp); chmod 600 "$hf"
  printf 'Authorization: Bearer %s\n' "$(cat "$AI_KEY_FILE")" > "$hf"
  code=$(curl -s --noproxy '*' ${GILDSITE_TLS:+-k} -o /dev/null -w '%{http_code}' --resolve "$DOMAIN:443:$ip" -H @"$hf" \
    -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' \
    -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-03-26","capabilities":{},"clientInfo":{"name":"gildsite-install","version":"1"}}}' \
    "https://$DOMAIN/api/mcp" || true)
  rm -f "$hf"; echo "$code"
}

# Connector name: "gildsite"; when that name already points to another Gildsite (several instances on one server),
# this one gets "gildsite-<instance>" so nothing is overwritten.
CONNECTOR=gildsite
client_claude() {
  local url="$1" key cur; key=$(cat "$AI_KEY_FILE")
  cur=$(as_ai claude mcp get gildsite 2>/dev/null | sed -n 's/^ *URL: *//p' | head -1 || true)
  [ -n "$cur" ] && [ "$cur" != "$url" ] && CONNECTOR="gildsite-$(instance_name)"
  as_ai claude mcp remove "$CONNECTOR" -s user >/dev/null 2>&1 || true
  as_ai claude mcp add --transport http --scope user "$CONNECTOR" "$url" --header "Authorization: Bearer $key" >> "$LOG" 2>&1
}
client_codex() {
  local url="$1" f d; d="$(ai_home)/.codex"; f="$d/config.toml"
  as_ai mkdir -p "$d"; as_ai touch "$f"
  if awk '/^\[mcp_servers\.gildsite\]/{s=1;next} /^\[/{s=0} s && /^url/' "$f" | grep -q . && ! awk '/^\[mcp_servers\.gildsite\]/{s=1;next} /^\[/{s=0} s && /^url/' "$f" | grep -qF "\"$url\""; then CONNECTOR="gildsite-$(instance_name)"; fi
  # Replace our own block only; everything else in the file stays as it was.
  as_ai sh -c "awk 'BEGIN{s=0} /^\[mcp_servers\.$CONNECTOR\]/{s=1;next} /^\[/{s=0} !s' '$f' > '$f.tmp' && cat '$f.tmp' > '$f' && rm -f '$f.tmp' && chmod 600 '$f'"
  { printf '\n[mcp_servers.%s]\nurl = "%s"\nhttp_headers = { Authorization = "Bearer %s" }\n' "$CONNECTOR" "$url" "$(cat "$AI_KEY_FILE")"; } | as_ai sh -c "cat >> '$f'"
}

cmd_aurelius() {
  need_consent; load_answers; ACTIVITY_ON=1
  is_done run || die "Gildsite is not installed yet." "Run ./gildsite-install run first."
  need_tool
  local dir uid client="${1:-auto}" url="https://$DOMAIN/api/mcp" out code
  dir=$(inst_dir); uid=$(inst_uid)
  case "$client" in auto|claude|codex|none) ;; *) die "Unknown AI client \"$client\"." "Use: aurelius [claude|codex|none]";; esac
  step "Aurelius: AI Access key for the AI on this server"
  local hostfile="$dir/dane/home/.gildsite-ai-access"
  rm -f "$hostfile"; trap 'rm -f "'"$hostfile"'"' RETURN EXIT
  out=$(connections -e PLIK=/app/.home/.gildsite-ai-access -e NAZWA="Server AI (installer)" -e DNI="${GILDSITE_AI_DAYS:-90}") \
    || die "Creating the AI Access key failed: ${out:-see the log}." "Check $LOG. The panel keeps working; AI Access can also be set up in the panel."
  [ -s "$hostfile" ] || die "The AI Access key file was not written." "Check $LOG."
  install -m 600 "$hostfile" "$AI_KEY_FILE"; rm -f "$hostfile"
  ok "AI Access key ready (stored in $AI_KEY_FILE, not shown). $(echo "$out" | grep -o 'WAZNE-DO=[0-9-]*' | sed 's/WAZNE-DO=/valid until /')"
  ok "It can read and write drafts only; publishing stays a person's click"
  code=$(mcp_check); [ "$code" = 200 ] && ok "Panel answers AI Access at $url" || warn "AI Access answered HTTP $code (check again after DNS and HTTPS work)"
  if [ "$client" = auto ]; then if [ "$AI" = openai ] && as_ai_has codex; then client=codex; elif as_ai_has claude; then client=claude; elif as_ai_has codex; then client=codex; else client=none; fi; fi
  case "$client" in
    claude) client_claude "$url" || die "Adding the panel to Claude Code failed." "Check $LOG."; ok "Claude Code ($(ai_user)): panel added as connector \"$CONNECTOR\"" ;;
    codex)  client_codex "$url" || die "Adding the panel to Codex failed." "Check $LOG."; ok "Codex ($(ai_user)): panel added as connector \"$CONNECTOR\" in ~/.codex/config.toml" ;;
    none)   warn "No Claude Code or Codex found for $(ai_user). Add a connector by hand: address $url, header Authorization: Bearer <contents of $AI_KEY_FILE>." ;;
  esac
  mark_done aurelius
  say ""; say "AURELIUS CONNECTED${client:+ ($client)}. Start a new AI session so it sees the \"$CONNECTOR\" tools. Next: ./gildsite-install github (optional) or finish"
}

gh_() { env -u GH_TOKEN -u GITHUB_TOKEN GH_CONFIG_DIR="$GH_DIR" gh "$@"; }

cmd_github() {
  need_consent; load_answers; ACTIVITY_ON=1
  is_done run || die "Gildsite is not installed yet." "Run ./gildsite-install run first."
  need_tool
  [ -n "${GITHUB_REPO:-}" ] || die "No repository chosen yet." "Ask the person which GitHub repository should get feedback (owner/name), then ./gildsite-install answer GITHUB_REPO owner/name."
  if ! have gh; then step "GitHub: install the GitHub tool (gh)"; sudo_ apt-get install -y gh >> "$LOG" 2>&1 || die "Installing gh failed." "Check $LOG."; fi
  mkdir -p "$GH_DIR"; chmod 700 "$GH_DIR"
  if ! gh_ auth status -h github.com >/dev/null 2>&1; then
    # Device login: the person opens a GitHub page and types a short code. No token goes through the chat.
    if [ -f "$GH_PID" ] && kill -0 "$(cat "$GH_PID")" 2>/dev/null; then
      say "Still waiting for the person to confirm on GitHub."
    else
      : > "$GH_OUT"; chmod 600 "$GH_OUT"
      ( env -u GH_TOKEN -u GITHUB_TOKEN GH_CONFIG_DIR="$GH_DIR" nohup gh auth login -h github.com -p https --web --skip-ssh-key -s repo </dev/null >"$GH_OUT" 2>&1 & echo $! > "$GH_PID" )
      local i; for i in $(seq 1 20); do grep -q 'one-time code' "$GH_OUT" && break; sleep 1; done
    fi
    local codeline; codeline=$({ grep -o 'one-time code: [A-Z0-9-]*' "$GH_OUT" || true; } | tail -1 | sed 's/one-time code: //')
    [ -n "$codeline" ] || die "GitHub did not give a login code: $(tail -1 "$GH_OUT")." "Check the internet connection and run ./gildsite-install github again."
    say "GITHUB=WAITING"
    say "Ask the person to open https://github.com/login/device, sign in, type the code $codeline and allow access."
    say "Then run ./gildsite-install github again."
    return 4
  fi
  step "GitHub: connect the panel to $GITHUB_REPO"
  local dir uid tok out; dir=$(inst_dir); uid=$(inst_uid); tok="$dir/dane/home/.gildsite-gh-token"
  trap 'rm -f "'"$tok"'"' RETURN EXIT
  ( umask 077; gh_ auth token > "$tok" ) || die "Reading the GitHub login failed." "Run ./gildsite-install github again."
  chown "$uid:$uid" "$tok" 2>/dev/null || true
  out=$(connections -e GITHUB_TOKEN_PLIK=/app/.home/.gildsite-gh-token -e REPO="$GITHUB_REPO") || true
  rm -f "$tok"
  case "$out" in
    *GITHUB=polaczono*) ;;
    *) die "GitHub refused: $(echo "$out" | sed -n 's/^GITHUB=blad //p' | head -1)" "Check the repository name and that this GitHub account can open issues there, then run ./gildsite-install github again." ;;
  esac
  # The panel now keeps its own encrypted copy; the installer does not keep a second one.
  gh_ auth logout -h github.com >/dev/null 2>&1 || true; rm -rf "$GH_DIR" "$GH_OUT" "$GH_PID"
  mark_done github
  ok "Panel connected to GitHub: $GITHUB_REPO (feedback goes there as issues)"
  say ""; say "GITHUB CONNECTED. Next: ./gildsite-install finish"
}

# ---------- progress card ("progress") ----------
# The installer keeps a small state file while it works; `progress` turns it into a card the AI shows in the chat:
# text for terminals (Claude Code, Codex), --html for chats that draw HTML widgets, --json for anything else.
# Only the installer's own messages go into it, never raw build logs, so no secret can leak through the card.
PROGRESS="$STATE_DIR/progress.env"
ACTIVITY="$STATE_DIR/activity.log"
RUN_STEPS=("Docker" "Gildsite code" "Libraries" "Website and panel" "Production settings and owner" "Web server and HTTPS" "Backup and updates")
RUN_MIN=(2 2 4 12 6 1 1)   # rough minutes per part, for "about N min left"

activity() { [ -n "${ACTIVITY_ON:-}" ] || return 0; mkdir -p "$STATE_DIR"; printf '%s|%s|%s\n' "$(date -u +%H:%M)" "$1" "$2" >> "$ACTIVITY"; chmod 600 "$ACTIVITY" 2>/dev/null || true; }
progress_set() { [ -n "${ACTIVITY_ON:-}" ] || return 0; mkdir -p "$STATE_DIR"; { printf 'P_STATE=%q\nP_STEP=%q\nP_MSG=%q\nP_AT=%q\n' "$1" "${2:-0}" "${3:-}" "$(date -u +%s)"; } > "$PROGRESS.tmp"; mv "$PROGRESS.tmp" "$PROGRESS"; }

progress_data() { # fills the P_* and C_* variables the three formats print
  load_answers; P_STATE=idle; P_STEP=0; P_MSG=""; P_AT=0; [ -f "$PROGRESS" ] && . "$PROGRESS"
  C_ITEMS=(); local n=0 s
  add() { C_ITEMS+=("$1|$2|$3"); }
  { [ -n "$DOMAIN" ] || [ "$TARGET" = local ]; } && [ -n "$OWNER_EMAIL" ] && [ -n "$COMPANY" ] && s=done || s=todo; add "Your answers" "$s" "Address, owner e-mail, company"
  if [ -n "$AI" ]; then s=todo; if is_done ai; then s="done"; fi; add "Your AI ($(ai_name))" "$s" ""; fi
  [ -f "$CONSENT" ] && s=done || s=todo; add "Your yes to the plan" "$s" ""
  # On a computer there is no DNS step; Docker is the first part of run.
  if [ "$TARGET" != local ]; then { is_done dns || [ -n "${GILDSITE_SKIP_DNS:-}" ]; } && s=done || s=todo; add "Address points to this server" "$s" "${DOMAIN}"; fi
  C_WHERE=Server; [ "$TARGET" = local ] && { C_WHERE=Computer; RUN_STEPS[5]="Preview on this computer"; }
  local i
  for i in "${!RUN_STEPS[@]}"; do
    if { [ "$P_STATE" != running ] && [ "$P_STATE" != failed ] && is_done run; } || { [ "$P_STATE" != idle ] && [ "$P_STEP" -gt $((i+1)) ]; }; then s=done
    elif [ "$P_STATE" = running ] && [ "$P_STEP" -eq $((i+1)) ]; then s=now
    elif [ "$P_STATE" = failed ] && [ "$P_STEP" -eq $((i+1)) ]; then s=failed
    else s=todo; fi
    add "${RUN_STEPS[$i]}" "$s" ""
  done
  is_done aurelius && s=done || s=todo; add "Connect Aurelius (optional)" "$s" ""
  is_done finish && s=done || s=todo; add "Login link for the owner" "$s" ""
  C_TOTAL=${#C_ITEMS[@]}; C_DONE=0; C_NOW=""
  for s in "${C_ITEMS[@]}"; do case "$s" in *"|done|"*) C_DONE=$((C_DONE+1));; *"|now|"*|*"|failed|"*) [ -n "$C_NOW" ] || C_NOW="${s%%|*}";; esac; done
  C_PCT=$(( C_DONE * 100 / C_TOTAL ))
  C_LEFT=0; if [ "$P_STATE" = running ] || ! is_done run; then for i in "${!RUN_MIN[@]}"; do [ "$P_STEP" -le $((i+1)) ] && C_LEFT=$((C_LEFT + RUN_MIN[i])); done; fi
  local mt ma
  if [ -r /proc/meminfo ]; then mt=$(awk '/MemTotal/{print $2}' /proc/meminfo); ma=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
  else mt=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 1024) / 1024 )); ma=$(( $(free_ram_gb) * 1048576 )); fi # a Mac
  C_RAM_USED=$(awk -v t="$mt" -v a="$ma" 'BEGIN{printf "%.1f", (t-a)/1048576}'); C_RAM_TOTAL=$(awk -v t="$mt" 'BEGIN{printf "%.0f", t/1048576}')
  C_RAM_PCT=$(( (mt-ma) * 100 / (mt > 0 ? mt : 1) ))
  local p="$GILDSITE_HOME"; while [ ! -d "$p" ]; do p=$(dirname "$p"); done
  if [ "$TARGET" = local ]; then read -r C_DISK_TOTAL C_DISK_USED < <(df -Pk "$p" | awk 'NR==2 {printf "%d %d\n", $2/1048576, $3/1048576}')
  else read -r C_DISK_TOTAL C_DISK_USED < <(df -BG --output=size,used "$p" | tail -1 | tr -d G); fi
  C_DISK_PCT=$(( C_DISK_USED * 100 / (C_DISK_TOTAL > 0 ? C_DISK_TOTAL : 1) ))
  if [ "$TARGET" = local ]; then C_HTTPS="not needed (preview on this computer)"
  elif is_done run; then [ "$WEB_SERVER" = existing ] && C_HTTPS="set up by the server admin" || C_HTTPS="on (Caddy)"; else C_HTTPS="not yet"; fi
  C_LAST=(); [ -f "$ACTIVITY" ] && { local l; while IFS= read -r l; do C_LAST+=("$l"); done < <(tail -3 "$ACTIVITY"); } # no mapfile: a Mac has bash 3.2
  if [ "$P_STATE" = failed ]; then C_MOVE="Something stopped: ${P_MSG}. I will explain what to do."
  elif { [ -z "$DOMAIN" ] && [ "$TARGET" != local ]; } || [ -z "$OWNER_EMAIL" ] || [ -z "$COMPANY" ]; then C_MOVE="Answer three short questions in the chat."
  elif [ -n "$AI" ] && ! is_done ai; then C_MOVE="Log in to your AI, $(ai_name) (the chat guides you; a key only in the secure field)."
  elif [ ! -f "$CONSENT" ]; then C_MOVE="Read the plan and say yes or no."
  elif [ "$TARGET" = local ] && ! is_done docker; then C_MOVE="Install or start Docker on this computer (the chat guides you step by step)."
  elif ! is_done dns && [ -z "${GILDSITE_SKIP_DNS:-}" ]; then C_MOVE="Add one DNS record at your domain provider (see the chat)."
  elif [ "$P_STATE" = running ]; then C_MOVE="Nothing. You can close this; I will write when it is done."
  elif is_done finish; then C_MOVE="Open your one-time login link and set a password."
  else C_MOVE="Nothing for now."; fi
  C_AGO=$(( $(date -u +%s) - P_AT )); [ "$P_AT" -gt 0 ] || C_AGO=-1
}

bar() { local pct=$1 w=${2:-24} f; f=$(( pct * w / 100 )); printf '%*s' "$f" '' | tr ' ' '#'; printf '%*s' $((w-f)) '' | tr ' ' '.'; }

progress_text() {
  local s name st det mark i=1 head
  case "$P_STATE" in running) head="Installing Gildsite";; failed) head="Gildsite: stopped";; *) is_done finish && head="Gildsite is ready" || head="Gildsite installer";; esac
  printf '%s  ·  %s\n' "$head" "${DOMAIN:-address not set}"
  printf '[%s] %d%%  ·  %d of %d done%s\n\n' "$(bar "$C_PCT")" "$C_PCT" "$C_DONE" "$C_TOTAL" "$( [ "$C_LEFT" -gt 0 ] && [ "$P_STATE" = running ] && echo "  ·  about $C_LEFT min left" )"
  for s in "${C_ITEMS[@]}"; do
    IFS='|' read -r name st det <<< "$s"
    case "$st" in done) mark="[x]";; now) mark="[>]";; failed) mark="[!]";; *) mark="[ ]";; esac
    printf ' %s %2d. %s%s\n' "$mark" "$i" "$name" "$( [ "$st" = now ] && echo '  (working now)' )"; i=$((i+1))
  done
  printf '\n%-8s memory %s of %s GB  ·  disk %s of %s GB  ·  HTTPS %s\n' "$C_WHERE" "$C_RAM_USED" "$C_RAM_TOTAL" "$C_DISK_USED" "$C_DISK_TOTAL" "$C_HTTPS"
  if [ ${#C_LAST[@]} -gt 0 ]; then printf 'Lately\n'; for s in "${C_LAST[@]}"; do IFS='|' read -r i st det <<< "$s"; printf '  %s  %s\n' "$i" "$det"; done; fi
  printf 'Your move: %s\n' "$C_MOVE"
}

esc() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e "s/'/\&#39;/g" -e 's/"/\&quot;/g'; }

progress_html() { # fragment for chat widgets; colours only through the chat's own theme variables
  local s name st det i=1 rows="" last="" head
  case "$P_STATE" in running) head="Installing Gildsite";; failed) head="Gildsite: stopped";; *) is_done finish && head="Gildsite is ready" || head="Gildsite installer";; esac
  for s in "${C_ITEMS[@]}"; do
    IFS='|' read -r name st det <<< "$s"
    rows+="<li class='$st'><span class='ic'>$( case "$st" in done) echo '&#10003;';; failed) echo '!';; now) echo '';; *) echo "$i";; esac )</span><span>$(esc "$name")$( [ "$st" = now ] && echo " <em>working now</em>" || true )</span></li>"; i=$((i+1))
  done
  [ ${#C_LAST[@]} -eq 0 ] || for s in "${C_LAST[@]}"; do IFS='|' read -r i st det <<< "$s"; last+="<div><span class='mu'>$(esc "$i")</span> $(esc "$det")</div>"; done
  cat <<HTML
<style>.gp{font:14px/1.45 system-ui,sans-serif;color:var(--text-primary);background:var(--surface-1);border:1px solid var(--border);border-radius:14px;padding:16px;max-width:620px}
.gp h3{margin:0;font-size:15px}.gp .mu{color:var(--text-secondary);font-size:12px}.gp .bar{height:8px;border-radius:99px;background:var(--border);margin:12px 0 4px;overflow:hidden}
.gp .bar i{display:block;height:100%;background:var(--text-accent)}.gp .cols{display:grid;grid-template-columns:1.2fr 1fr;gap:14px;margin-top:12px}
@media(max-width:520px){.gp .cols{grid-template-columns:1fr}}.gp ol{list-style:none;margin:0;padding:0}.gp li{display:flex;gap:8px;align-items:center;padding:4px 0}
.gp .ic{width:18px;height:18px;border-radius:50%;border:1.5px solid var(--border);display:grid;place-items:center;font-size:11px;color:var(--text-muted)}
.gp .done .ic{background:var(--text-success);border-color:var(--text-success);color:var(--surface-1)}.gp .done{color:var(--text-secondary)}
.gp .now .ic{border-color:var(--text-accent)}.gp .now .ic::after{content:'';width:8px;height:8px;border-radius:50%;background:var(--text-accent)}
.gp .failed .ic{border-color:var(--text-danger);color:var(--text-danger)}.gp .todo{color:var(--text-muted)}.gp em{color:var(--text-accent);font-style:normal;font-size:12px}
.gp .box{border:1px solid var(--border);border-radius:10px;padding:8px 10px;margin-bottom:8px;font-size:13px}.gp .lab{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--text-muted)}
.gp .mv{color:var(--text-warning)}</style>
<div class='gp'><h3>$(esc "$head")</h3><div class='mu'>$(esc "${DOMAIN:-address not set}")$( [ "$C_AGO" -ge 0 ] && echo " · updated ${C_AGO}s ago" )</div>
<div class='bar'><i style='width:${C_PCT}%'></i></div><div class='mu'>${C_DONE} of ${C_TOTAL} done · ${C_PCT}%$( [ "$C_LEFT" -gt 0 ] && [ "$P_STATE" = running ] && echo " · about ${C_LEFT} min left" )</div>
<div class='cols'><ol>${rows}</ol><div>
<div class='box'><div class='lab'>$(esc "$C_WHERE")</div>Memory ${C_RAM_USED} of ${C_RAM_TOTAL} GB<div class='bar'><i style='width:${C_RAM_PCT}%'></i></div>Disk ${C_DISK_USED} of ${C_DISK_TOTAL} GB<div class='bar'><i style='width:${C_DISK_PCT}%'></i></div>HTTPS: $(esc "$C_HTTPS")</div>
$( [ -n "$last" ] && echo "<div class='box'><div class='lab'>Lately</div>${last}</div>" )
<div class='box'><div class='lab'>Your move</div><span class='mv'>$(esc "$C_MOVE")</span></div></div></div></div>
HTML
}

json_s() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
progress_json() {
  local s name st det first=1
  printf '{"state":"%s","domain":"%s","done":%d,"total":%d,"percent":%d,"minutes_left":%d,"your_move":"%s","https":"%s","memory_gb":{"used":%s,"total":%s},"disk_gb":{"used":%s,"total":%s},"steps":[' \
    "$P_STATE" "$(json_s "$DOMAIN")" "$C_DONE" "$C_TOTAL" "$C_PCT" "$C_LEFT" "$(json_s "$C_MOVE")" "$(json_s "$C_HTTPS")" "$C_RAM_USED" "$C_RAM_TOTAL" "$C_DISK_USED" "$C_DISK_TOTAL"
  for s in "${C_ITEMS[@]}"; do IFS='|' read -r name st det <<< "$s"; [ $first = 1 ] || printf ','; first=0; printf '{"name":"%s","status":"%s"}' "$(json_s "$name")" "$st"; done
  printf ']}\n'
}

cmd_progress() {
  progress_data
  case "${1:-}" in --html) progress_html ;; --json) progress_json ;; *) progress_text ;; esac
}

cmd_status() {
  load_answers
  say "Gildsite installer $VERSION: status"
  local i=1 s name desc mark
  for s in "${STEPS[@]}"; do
    name=${s%%|*}; desc=${s#*|}; mark="[ ]"
    case "$name" in
      check)   ( cmd_check >/dev/null 2>&1 ) && mark="[x]" ;;
      answers) { [ -n "$DOMAIN" ] || [ "$TARGET" = local ]; } && [ -n "$OWNER_EMAIL" ] && [ -n "$COMPANY" ] && mark="[x]" ;;
      ai)      [ -n "$AI" ] || continue; desc="$desc, now: $(ai_name)"; is_done ai && mark="[x]" ;;
      consent) [ -f "$CONSENT" ] && mark="[x]" ;;
      dns)     if [ "$TARGET" = local ]; then mark="[-]"; desc="$desc (not needed on a computer)"; elif is_done dns; then mark="[x]"; fi ;;
      *)       is_done "$name" && mark="[x]" ;;
    esac
    printf '  %s %d. %s\n' "$mark" "$i" "$desc"; i=$((i+1))
  done
}

usage() {
  cat <<USE
Gildsite installer $VERSION. Read INSTALL-FOR-AI.md first.

  check [--json]        look at the server or computer (read-only)
  docker-help           step-by-step Docker guide for this computer (read-only)
  ai                    your AI: login check and connection test (answer AI claude|openai|gemini|grok|other first)
  ai-key                the PERSON types the AI API key here, in their own terminal (hidden; never in the chat)
  answer KEY VALUE      save TARGET server|local, DOMAIN, OWNER_EMAIL, COMPANY, AI (also AI_LOGIN window|key,
                        AI_URL and AI_NAME for another AI, PUBLISH server|cloudflare,
                        DESIGN on|off, RELEASE, INSTANCE, WEB_SERVER, JOBS backup,knowledge,updates|none,
                        OWNER_LINK yes|no, GITHUB_REPO)
  plan                  show what will happen (read-only)
  consent yes           record the person's yes (only after they said it)
  dns                   show DNS records and check them (read-only)
  key                   save the download key from input (needs consent; never print it)
  run                   install and start everything (needs consent)
  aurelius [claude|codex|none]  connect Aurelius to the AI on this server (needs consent)
  github                connect GitHub (needs consent and answer GITHUB_REPO; run again after the person confirms)
  finish                final check and owner login link (needs consent)
  status                which steps are done
  progress [--html|--json]  progress card for the chat (text, HTML widget or data)
USE
}

case "${1:-}" in
  check)    shift; cmd_check "${1:-}" ;;
  docker-help) cmd_docker_help ;;
  ai)       cmd_ai ;;
  ai-key)   cmd_ai_key ;;
  answer)   shift; cmd_answer "${1:-}" "${2:-}" ;;
  plan)     cmd_plan ;;
  consent)  shift; cmd_consent "${1:-}" ;;
  dns)      cmd_dns ;;
  run)      cmd_run ;;
  key)      cmd_key ;;
  finish)   cmd_finish ;;
  aurelius) shift; cmd_aurelius "${1:-}" ;;
  github)   cmd_github ;;
  status)   cmd_status ;;
  progress) shift; cmd_progress "${1:-}" ;;
  version)  say "$VERSION" ;;
  ""|help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
