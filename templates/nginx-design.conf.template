# Design (Doop) for __DOMAIN__ at __DESIGN_HOST__. Written by gildsite-install for a server that already runs nginx;
# the installer does not change nginx. To use:
#   cp this file /etc/nginx/sites-available/__DESIGN_HOST__ && ln -s ../sites-available/__DESIGN_HOST__ /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx && certbot --nginx -d __DESIGN_HOST__
# Only the panel at https://__DOMAIN__ may show Design in a frame; search engines are told not to index it.
server {
    listen 80;
    server_name __DESIGN_HOST__;
    client_max_body_size 50m;

    proxy_hide_header X-Frame-Options;
    proxy_hide_header Content-Security-Policy;
    add_header Content-Security-Policy "frame-ancestors https://__DOMAIN__" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    # Live editing (WebSocket)
    location /ws {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }
    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
