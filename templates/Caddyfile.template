# Gildsite web server (Caddy). Generated by gildsite-install; do not edit by hand.
# One address for website and panel, the same split as docs/nginx-klient.conf of the template:
# /admin, /api, /_next, /edytor go to the panel, everything else to the website.
# Caddy gets and renews HTTPS certificates by itself. Addresses come from the answers, never hard-coded.
{
	email __EMAIL__
}

__DOMAIN__ {
	__TLS__
	encode zstd gzip
	request_body {
		max_size 50MB
	}
	@panel path /admin /admin/* /api /api/* /_next /_next/* /edytor /edytor/*
	handle @panel {
		reverse_proxy panel:3000
	}
	handle {
		reverse_proxy strona:4321
	}
}

__ALIAS__ {
	__TLS__
	redir https://__DOMAIN__{uri} permanent
}
