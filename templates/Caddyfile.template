# Gildsite web server (Caddy). Generated by gildsite-install from answers.env; do not edit by hand.
# Caddy gets and renews HTTPS certificates by itself. Addresses come from answers, never hard-coded.
{
	email {$OWNER_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy strona:4321
}

{$PANEL_DOMAIN} {
	encode zstd gzip
	# The panel also serves /api/mcp (the AI connector) and the Design bridge.
	reverse_proxy panel:3000
}
